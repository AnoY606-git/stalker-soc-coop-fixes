function if_actor_has_agr_safe_container_1(first_speaker, second_speaker)
	return first_speaker:object("agr_safe_container_1") ~= nil
end

function if_actor_hasnt_agr_safe_container_1(first_speaker, second_speaker)
	return not if_actor_has_agr_safe_container_1(first_speaker, second_speaker)
end

function transfer_agr_safe_container_1(first_speaker, second_speaker)
	dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "agr_safe_container_1")
end



function if_actor_has_dev_flash_agru(first_speaker, second_speaker)
	return first_speaker:object("dev_flash_agru") ~= nil
end

function if_actor_hasnt_dev_flash_agru(first_speaker, second_speaker)
