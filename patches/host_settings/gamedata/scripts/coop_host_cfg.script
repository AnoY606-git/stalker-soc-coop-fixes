-- Host settings for Shadow of COOP (patch host_settings). SERVER / HOST ONLY.
--
-- One plain-text file, coop_settings.ltx, in the HOST's app data folder ($app_data_root$: _appdata_ for a player who hosts,
-- _appdata_server for a dedicated server). It is NOT part of the add-on, so editing it does not change the add-on checksum and
-- the other players need nothing. Values in it override the defaults that ship in the db (the db ltx files stay the defaults).
--
--   coop_host_cfg.num(section, key, default)    number  (comma or dot as decimal mark)
--   coop_host_cfg.bool(section, key, default)   true/false/yes/no/on/off/1/0
--   coop_host_cfg.str(section, key, default)    raw text
--
--   coop_host_cfg.client_str(key, default)      text from the PERSONAL [client] section; read on EVERY machine (also a joined client)
--
-- The [client] section is the only part every player reads, each from HIS OWN coop_settings.ltx (voice_language of the opening speech). On a
-- machine that is not the server the file is created with just that section when it is missing, and the section is appended to an older
-- file that lacks it. All other sections stay server only.
-- Rules: a missing file, section, key or a value that does not parse gives `default` (a bad value is logged once, never an error).
-- On a machine that is not the server (a joined client) num/bool/str just return `default` and never touch the file; only client_str reads (and
-- creates or completes) the personal [client] section of that machine's own file.
-- First server start without the file: it is WRITTEN with every host-editable setting, its current db default and an EN + RU comment.
-- At the first read of every level start one summary line with all effective values (and which came from the file) is logged:
-- "[HOSTCFG] ..." in the engine log and in logs\host_cfg.log.

local FILE_NAME = "coop_settings.ltx"
local VER = 1

local st = nil              -- { path, vals = { [sec] = { [key] = raw } }, found, created, nfile, write_err }
local bad_seen = {}         -- "sec.key" -> true (already logged)
local bad_count_n = 0
local ini_cache = {}
local loading = false

last_line = ""              -- the last summary line (tests read it)

-----------------------------------------------------------------------------------------------------------------
-- helpers
-----------------------------------------------------------------------------------------------------------------
local function trim(s)
	return (string.gsub(s or "", "^%s*(.-)%s*$", "%1"))
end

local function is_server()
	local ok, r = pcall(function() return OnServer() end)
	return ok and r == true
end

local function lg(s)
	pcall(function()
		local i = 1
		local n = string.len(s)
		while i <= n do
			printf_msg("[HOSTCFG] %s", string.sub(s, i, i + 899))
			i = i + 900
		end
	end)
	pcall(function()
		local f = io.open(getFS():update_path("$logs$", "host_cfg.log"), "a")
		if f then
			f:write(string.format("[%8.1f] %s\n", time_global() / 1000, s))
			f:close()
		end
	end)
end

local function to_num(raw)
	if raw == nil then return nil end
	local v = tonumber((string.gsub(trim(raw), ",", ".")))
	if v == nil or v ~= v or v == math.huge or v == -math.huge then return nil end
	return v
end

local function to_bool(raw)
	if raw == nil then return nil end
	local s = string.lower(trim(raw))
	if s == "true" or s == "yes" or s == "on" or s == "1" then return true end
	if s == "false" or s == "no" or s == "off" or s == "0" then return false end
	return nil
end

local function fmt_num(v)
	return string.format("%.6g", v)
end

-- the value as text, or nil when `raw` is not valid for that kind
local function norm(kind, raw)
	if raw == nil then return nil end
	if kind == "num" then
		local v = to_num(raw)
		if v == nil then return nil end
		return fmt_num(v)
	elseif kind == "bool" then
		local b = to_bool(raw)
		if b == nil then return nil end
		return b and "true" or "false"
	end
	return trim(raw)
end

local function path_of()
	return getFS():update_path("$app_data_root$", FILE_NAME)
end

-----------------------------------------------------------------------------------------------------------------
-- the settings the file is created with: group(section, EN, RU), K(key, kind, default, EN, RU [, db ltx file, ltx section])
-- The written value is read from the db ltx when `ltx` is given (so the file always starts equal to the shipped defaults).
-----------------------------------------------------------------------------------------------------------------
local groups = nil

local function build_groups()
	local g = {}
	local cur = nil
	local function G(sec, en, ru, avail)
		cur = { sec = sec, en = en, ru = ru, avail = avail, knobs = {} }
		table.insert(g, cur)
	end
	local function K(key, kind, def, en, ru, ltx, lsec)
		table.insert(cur.knobs, { sec = cur.sec, key = key, kind = kind, def = def, en = en, ru = ru, ltx = ltx, lsec = lsec or cur.sec })
	end
	local BAL = "misc\\coop_balance.ltx"
	local PS = "player_scaling.ltx"
	local BOX = "misc\\box_loot.ltx"
	local RQ = "misc\\coop_repeat_quests.ltx"
	local ML = "misc\\mutant_loot.ltx"
	local RM = "misc\\alife_roaming.ltx"

	G("client", "Personal settings of each player (read on EVERY machine, each player edits HIS OWN file)", "\208\155\208\184\209\135\208\189\209\139\208\181 \208\189\208\176\209\129\209\130\209\128\208\190\208\185\208\186\208\184 \208\184\208\179\209\128\208\190\208\186\208\176 (\209\135\208\184\209\130\208\176\209\142\209\130\209\129\209\143 \208\189\208\176 \208\154\208\144\208\150\208\148\208\158\208\156 \208\186\208\190\208\188\208\191\209\140\209\142\209\130\208\181\209\128\208\181, \209\131 \208\186\208\176\208\182\208\180\208\190\208\179\208\190 \209\129\208\178\208\190\208\185 \209\132\208\176\208\185\208\187)")
