end

local function get_groups()
	if groups == nil then groups = build_groups() end
	return groups
end

local function ini_of(name)
	local i = ini_cache[name]
	if i == nil then
		local ok, r = pcall(function() return ini_file(name) end)
		i = (ok and r) or false
		ini_cache[name] = i
	end
	return i
end

-- the default that ships in the db (the ltx value when the knob has one), as text
local function db_default(k)
	if k.ltx ~= nil then
		local ini = ini_of(k.ltx)
		if ini then
			local ok, v = pcall(function()
				if ini:section_exist(k.lsec) and ini:line_exist(k.lsec, k.key) then return ini:r_string(k.lsec, k.key) end
				return nil
			end)
			if ok and v ~= nil then
				local n = norm(k.kind, v)
				if n ~= nil then return n end
			end
		end
	end
	local d = k.def
	if type(d) == "function" then
		local ok, v = pcall(d)
		d = ok and v or nil
	end
	if d == nil then return nil end
	if k.kind == "num" then
		local v = tonumber(d)
		return v ~= nil and fmt_num(v) or nil
	elseif k.kind == "bool" then
		return d and "true" or "false"
	end
	return tostring(d)
end

local function group_ok(grp)
	if grp.avail == nil then return true end
	local ok, r = pcall(grp.avail)
	return ok and r == true
end

-----------------------------------------------------------------------------------------------------------------
-- the file
-----------------------------------------------------------------------------------------------------------------
local function build_text()
	local o = {}
	local function add(s) table.insert(o, s) end
	add("; coop_settings.ltx - Shadow of COOP host settings (made by the fix patch, settings version " .. VER .. ")")
	add("; ONLY THE HOST needs this file: the player who hosts the game, or the dedicated server. Other players do not read it and need nothing.")
	add("; Change a value, save, then change the level or restart the server: the file is read again at every level start.")
	add("; A line you delete or a value that is not a number/true/false uses the default. Delete the whole file to get a fresh one with the defaults.")
	add("; Lines starting with ; are comments.")
	add("; The [client] section is PERSONAL: every player (also one who only joins a game) reads it from HIS OWN coop_settings.ltx. All other sections are read by the host only.")
	add(";")
	add("; \208\173\209\130\208\190\209\130 \209\132\208\176\208\185\208\187 \208\189\209\131\208\182\208\181\208\189 \208\162\208\158\208\155\208\172\208\154\208\158 \208\165\208\158\208\161\208\162\208\163: \208\184\208\179\209\128\208\190\208\186\209\131, \208\186\208\190\209\130\208\190\209\128\209\139\208\185 \209\129\208\190\208\183\208\180\208\176\209\145\209\130 \208\184\208\179\209\128\209\131, \208\184\208\187\208\184 \208\178\209\139\208\180\208\181\208\187\208\181\208\189\208\189\208\190\208\188\209\131 \209\129\208\181\209\128\208\178\208\181\209\128\209\131. \208\158\209\129\209\130\208\176\208\187\209\140\208\189\209\139\208\188 \208\184\208\179\209\128\208\190\208\186\208\176\208\188 \208\189\208\184\209\135\208\181\208\179\208\190 \208\189\208\181 \208\189\209\131\208\182\208\189\208\190.")
	add("; \208\152\208\183\208\188\208\181\208\189\208\184\209\130\208\181 \208\183\208\189\208\176\209\135\208\181\208\189\208\184\208\181, \209\129\208\190\209\133\209\128\208\176\208\189\208\184\209\130\208\181 \209\132\208\176\208\185\208\187, \208\183\208\176\209\130\208\181\208\188 \209\129\208\188\208\181\208\189\208\184\209\130\208\181 \208\187\208\190\208\186\208\176\209\134\208\184\209\142 \208\184\208\187\208\184 \208\191\208\181\209\128\208\181\208\183\208\176\208\191\209\131\209\129\209\130\208\184\209\130\208\181 \209\129\208\181\209\128\208\178\208\181\209\128: \209\132\208\176\208\185\208\187 \209\135\208\184\209\130\208\176\208\181\209\130\209\129\209\143 \208\183\208\176\208\189\208\190\208\178\208\190 \208\191\209\128\208\184 \209\129\209\130\208\176\209\128\209\130\208\181 \208\186\208\176\208\182\208\180\208\190\208\185 \208\187\208\190\208\186\208\176\209\134\208\184\208\184.")
	add("; \208\163\208\180\208\176\208\187\209\145\208\189\208\189\208\176\209\143 \209\129\209\130\209\128\208\190\208\186\208\176 \208\184\208\187\208\184 \208\189\208\181\208\178\208\181\209\128\208\189\208\190\208\181 \208\183\208\189\208\176\209\135\208\181\208\189\208\184\208\181 = \208\183\208\189\208\176\209\135\208\181\208\189\208\184\208\181 \208\191\208\190 \209\131\208\188\208\190\208\187\209\135\208\176\208\189\208\184\209\142. \208\163\208\180\208\176\208\187\208\184\209\130\208\181 \209\132\208\176\208\185\208\187 \209\134\208\181\208\187\208\184\208\186\208\190\208\188, \209\135\209\130\208\190\208\177\209\139 \208\191\208\190\208\187\209\131\209\135\208\184\209\130\209\140 \208\189\208\190\208\178\209\139\208\185 \209\129 \208\183\208\189\208\176\209\135\208\181\208\189\208\184\209\143\208\188\208\184 \208\191\208\190 \209\131\208\188\208\190\208\187\209\135\208\176\208\189\208\184\209\142.")
	add("; \208\161\209\130\209\128\208\190\208\186\208\184, \208\189\208\176\209\135\208\184\208\189\208\176\209\142\209\137\208\184\208\181\209\129\209\143 \209\129 ;, - \208\186\208\190\208\188\208\188\208\181\208\189\209\130\208\176\209\128\208\184\208\184.")
	add("; \208\160\208\176\208\183\208\180\208\181\208\187 [client] \208\155\208\152\208\167\208\157\208\171\208\153: \208\181\208\179\208\190 \209\135\208\184\209\130\208\176\208\181\209\130 \208\154\208\144\208\150\208\148\208\171\208\153 \208\184\208\179\209\128\208\190\208\186 \208\184\208\183 \208\161\208\146\208\158\208\149\208\147\208\158 coop_settings.ltx (\208\184 \209\130\208\190\209\130, \208\186\209\130\208\190 \209\130\208\190\208\187\209\140\208\186\208\190 \208\191\208\190\208\180\208\186\208\187\209\142\209\135\208\176\208\181\209\130\209\129\209\143). \208\158\209\129\209\130\208\176\208\187\209\140\208\189\209\139\208\181 \209\128\208\176\208\183\208\180\208\181\208\187\209\139 \209\135\208\184\209\130\208\176\208\181\209\130 \209\130\208\190\208\187\209\140\208\186\208\190 \209\133\208\190\209\129\209\130.")
	for _, grp in ipairs(get_groups()) do
		if group_ok(grp) then
			add("")
			add("; ---- " .. grp.en .. " / " .. grp.ru)
			add("[" .. grp.sec .. "]")
			for _, k in ipairs(grp.knobs) do
				local v = db_default(k)
				if v ~= nil then
					add("; " .. k.en)
					add("; " .. k.ru)
					add(k.key .. " = " .. v)
				end
			end
		end
	end
	return table.concat(o, "\n") .. "\n"
end

-- the text of just the [client] group (appended to an older file, or the body of a new client-only file)
local function client_block()
	local o = {}
	for _, grp in ipairs(get_groups()) do
		if grp.sec == "client" then
			o[#o + 1] = ""
			o[#o + 1] = "; ---- " .. grp.en .. " / " .. grp.ru
			o[#o + 1] = "[" .. grp.sec .. "]"
			for _, k in ipairs(grp.knobs) do
				local v = db_default(k)
				if v ~= nil then
					o[#o + 1] = "; " .. k.en
					o[#o + 1] = "; " .. k.ru
					o[#o + 1] = k.key .. " = " .. v
				end
			end
		end
	end
	return table.concat(o, "\n") .. "\n"
end

local function client_file_text()
	return "; coop_settings.ltx - personal settings of this player (made by the Shadow of COOP fix patch, settings version " .. VER .. ")\n"
		.. "; Change a value, save, then change the level: the file is read again at every level start. Lines starting with ; are comments.\n"
		.. "; \208\155\208\184\209\135\208\189\209\139\208\181 \208\189\208\176\209\129\209\130\209\128\208\190\208\185\208\186\208\184 \208\184\208\179\209\128\208\190\208\186\208\176. \208\152\208\183\208\188\208\181\208\189\208\184\209\130\208\181 \208\183\208\189\208\176\209\135\208\181\208\189\208\184\208\181, \209\129\208\190\209\133\209\128\208\176\208\189\208\184\209\130\208\181 \209\132\208\176\208\185\208\187, \208\183\208\176\209\130\208\181\208\188 \209\129\208\188\208\181\208\189\208\184\209\130\208\181 \208\187\208\190\208\186\208\176\209\134\208\184\209\142 (\209\132\208\176\208\185\208\187 \209\135\208\184\209\130\208\176\208\181\209\130\209\129\209\143 \208\183\208\176\208\189\208\190\208\178\208\190 \208\191\209\128\208\184 \208\186\208\176\208\182\208\180\208\190\208\188 \209\129\209\130\208\176\209\128\209\130\208\181 \208\187\208\190\208\186\208\176\209\134\208\184\208\184).\n"
		.. client_block()
end

-- append the [client] block to an existing file that has no voice_language key (any machine)
local function append_client_block(path_)
	local w = io.open(path_, "a")
	if w == nil then error("cannot open for appending") end
	w:write("\n" .. client_block())
	w:close()
end

local function parse(text)
	local vals, n, sec = {}, 0, ""
	if string.sub(text, 1, 3) == "\239\187\191" then text = string.sub(text, 4) end
	for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
		line = (string.gsub(line, "\r", ""))
		local sc = string.find(line, ";", 1, true)
		if sc then line = string.sub(line, 1, sc - 1) end
		line = trim(line)
		if line ~= "" then
			local s = string.match(line, "^%[([^%]]*)%]$")
			if s ~= nil then
				sec = string.lower(trim(s))
			else
				local k, v = string.match(line, "^([^=]+)=(.*)$")
				if k ~= nil then
					k = string.lower(trim(k))
					if k ~= "" then
						if vals[sec] == nil then vals[sec] = {} end
						vals[sec][k] = trim(v)
						n = n + 1
					end
				end
			end
		end
	end
	return vals, n
end

local function value_text(sec, key)
	if st == nil or st.vals == nil then return nil end
	local s = st.vals[string.lower(sec)]
	if s == nil then return nil end
	return s[string.lower(key)]
end

-- every setting of the table with its effective value
local function effective_list()
	local out = {}
	for _, grp in ipairs(get_groups()) do
		if group_ok(grp) then
			for _, k in ipairs(grp.knobs) do
				local d = db_default(k)
				local raw = value_text(k.sec, k.key)
				local n = raw ~= nil and norm(k.kind, raw) or nil
				table.insert(out, { sec = k.sec, key = k.key, value = n or d, from_file = (n ~= nil), db = d, bad = (raw ~= nil and n == nil), raw = raw })
			end
		end
	end
	return out
end

local function announce()
	local parts, nf, nd, nbad = {}, 0, 0, 0
	for _, e in ipairs(effective_list()) do
		if e.value ~= nil then
			local tag = ""
			if e.from_file then
				tag = "(file)"
				nf = nf + 1
			else
				nd = nd + 1
			end
			if e.bad then
				nbad = nbad + 1
				tag = "(bad value '" .. tostring(e.raw) .. "', default used)"
				if not bad_seen[e.sec .. "." .. e.key] then
					bad_seen[e.sec .. "." .. e.key] = true
					bad_count_n = bad_count_n + 1
				end
			end
			table.insert(parts, e.sec .. "." .. e.key .. "=" .. e.value .. tag)
		end
	end
	local how
	if st.created then how = "file created with the defaults"
	elseif st.found then how = "file read (" .. tostring(st.nfile) .. " settings in it)"
	else how = "no file and it could not be created (" .. tostring(st.write_err) .. "), db defaults" end
	last_line = string.format("host settings v%d %s [%s]: %d value(s) from the file, %d from the db defaults, %d bad; effective: %s",
		VER, FILE_NAME, how, nf, nd, nbad, table.concat(parts, " "))
	lg(string.format("path=%s", tostring(st.path)))
	lg(last_line)
end

-- read (and create when missing) once per VM
local function state()
	if st ~= nil then return st end
	if loading then return nil end
	loading = true
	local ok, err = pcall(function()
		local s = { vals = {}, found = false, created = false, nfile = 0 }
		s.path = path_of()
		local f = io.open(s.path, "r")
		if f ~= nil then
			local text = f:read("*a") or ""
			f:close()
			s.found = true
			s.vals, s.nfile = parse(text)
			if s.vals["client"] == nil or s.vals["client"]["voice_language"] == nil then
				-- an older file without the personal section: add it (the other lines stay as they are)
				local oka, ea = pcall(append_client_block, s.path)
				s.appended = oka
				if not oka then s.write_err = tostring(ea) end
			end
		else
			local okw, e2 = pcall(function()
				local w = io.open(s.path, "w")
				if w == nil then error("cannot open for writing") end
				w:write(build_text())
				w:close()
			end)
			s.created = okw
			if not okw then s.write_err = tostring(e2) end
		end
		st = s
		announce()
	end)
	loading = false
	if not ok then
		lg("error reading " .. FILE_NAME .. ": " .. tostring(err))
		if st == nil then st = { vals = {}, found = false, created = false, nfile = 0, path = "?", write_err = tostring(err) } end
	end
	return st
end

-----------------------------------------------------------------------------------------------------------------
-- public API
-----------------------------------------------------------------------------------------------------------------
local function bad(sec, key, raw, default)
	local id = sec .. "." .. key
	if bad_seen[id] then return end
	bad_seen[id] = true
	bad_count_n = bad_count_n + 1
	lg(string.format("bad value for %s in %s: '%s' (using the default %s)", id, FILE_NAME, tostring(raw), tostring(default)))
end

local function raw_of(sec, key)
	if not is_server() then return nil end
	if state() == nil then return nil end
	return value_text(sec, key)
end

-- the personal [client] section on a machine that is NOT the server (a joined client): read (and create / complete) its own file
local cs = nil
local function client_state()
	if cs ~= nil then return cs end
	local c = { vals = {}, found = false, created = false, appended = false, path = "?" }
	cs = c
	local ok, err = pcall(function()
		c.path = path_of()
		local f = io.open(c.path, "r")
		if f ~= nil then
			local text = f:read("*a") or ""
			f:close()
			c.found = true
			c.vals = parse(text)
			if c.vals["client"] == nil or c.vals["client"]["voice_language"] == nil then
				append_client_block(c.path)
				c.appended = true
			end
		else
			local w = io.open(c.path, "w")
			if w == nil then error("cannot open for writing") end
			w:write(client_file_text())
			w:close()
			c.created = true
		end
	end)
	if not ok then c.err = tostring(err) end
	lg(string.format("client settings %s [%s]: path=%s%s", FILE_NAME,
		c.created and "file created" or (c.appended and "file read, [client] section appended" or (c.found and "file read" or "no file")),
		tostring(c.path), c.err and (" error=" .. c.err) or ""))
	return c
end

-- text of the personal [client] setting `key` on THIS machine (server or not); `default` when the file has no valid value
function client_str(key, default)
	local raw
	if is_server() then
		raw = raw_of("client", key)
	else
		local c = client_state()
		local sec = c and c.vals and c.vals["client"]
		raw = sec and sec[string.lower(key)]
	end
	if raw == nil or trim(raw) == "" then return default end
	return trim(raw)
end

function num(sec, key, default)
	local raw = raw_of(sec, key)
	if raw == nil then return default end
	local v = to_num(raw)
	if v == nil then bad(sec, key, raw, default) return default end
	return v
end

function bool(sec, key, default)
	local raw = raw_of(sec, key)
	if raw == nil then return default end
	local v = to_bool(raw)
	if v == nil then bad(sec, key, raw, default) return default end
	return v
end

function str(sec, key, default)
	local raw = raw_of(sec, key)
	if raw == nil then return default end
	return raw
end

-- true when sec.key has a valid value in the file (tests / logs)
function from_file(sec, key)
	local raw = raw_of(sec, key)
	return raw ~= nil
end

function bad_count() return bad_count_n end

function path()
	local ok, p = pcall(path_of)
	return ok and p or nil
end

-- text of a fresh file with the db defaults (tests)
function default_text() return build_text() end

-- throw the parsed file away and read it again (tests, after they wrote a file); the consumers drop their caches too.
-- Returns the new summary line.
function reload()
	st = nil
	cs = nil
	bad_seen = {}
	bad_count_n = 0
	ini_cache = {}
	groups = nil
	pcall(function() coop_balance.host_reload() end)
	pcall(function() player_scaling.host_reload() end)
	pcall(function() stash_loot.host_reload() end)
	pcall(function() coop_repeat_quests.host_reload() end)
	pcall(function() alife_roaming.host_reload() end)
	if is_server() then state() end
	return last_line
end
