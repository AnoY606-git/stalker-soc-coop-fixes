<!-- coop_scn_monolith: tutorial blocks of scene package "monolith". pause_state off, can_be_stopped off (the director stops them). -->

	<scn_monolith_join>
		<play_each_item>1</play_each_item>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
		</global_wnd>
		<item type="video">
			<sound>characters_voice\scenario\video\dream_doctor_2</sound>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<video_wnd x="0" y="0" width="1024" height="768" stretch="1">
				<texture x="0" y="1" width="512" height="286">intro\dream_doctor_2</texture>
			</video_wnd>
		</item>
	</scn_monolith_join>

	<scn_monolith_join_card>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
			<auto_static start_time="0" length_sec="14" x="112" y="340" width="800" height="90" alignment="c" stretch="1"><text font="letterica18" r="220" g="220" b="220" a="255" align="c">scn_monolith_join_card</text></auto_static>
		</global_wnd>
		<item>
			<length_sec>14</length_sec>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<grab_input>0</grab_input>
			<main_wnd/>
		</item>
	</scn_monolith_join_card>

	<!-- HD copies of the movie blocks above (Full HD movies of the SoC Enhanced Edition Cutscenes pack, textures\intro_hd\NAME.ogm). Same window, sound and timing; only the video file and the source rectangle (1919x1076 of the 1920x1080 frame) differ. coop_scenes.hd_tutorial() starts the block NAME_hd instead of NAME when the movie file exists. -->

	<scn_monolith_join_hd>
		<play_each_item>1</play_each_item>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
		</global_wnd>
		<item type="video">
			<sound>characters_voice\scenario\video\dream_doctor_2</sound>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<video_wnd x="0" y="0" width="1024" height="768" stretch="1">
				<texture x="0" y="1" width="1919" height="1076">intro_hd\dream_doctor_2</texture>
			</video_wnd>
		</item>
	</scn_monolith_join_hd>
