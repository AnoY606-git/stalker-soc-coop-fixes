function if_actor_has_mutant_boar_part_15x(first_speaker, second_speaker)
	local actor = db.mp_actors[LocalActor()]
	local count = 0
	
	if actor ~= nil then
		actor:iterate_inventory(
			function(dummy,item)
				if item:section() == "mutant_boar_part" then count = count + 1
				end
			end, nil)
		if count >= 7 then return true
		end
	end
	
	return false
end

function transfer_mutant_boar_part_15x(first_speaker, second_speaker)	
	dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "mutant_boar_part" , 7)
end



