-- Max flash drive quest (original SoC "Max / crazy_flash" job) - Army Warehouses (coop_l07_military)
local function flash_holder(first_speaker, second_speaker)
	local npc, actor = dialogs.who_is_npc(first_speaker, second_speaker)
	return actor ~= nil and actor:object("crazy_flash") ~= nil
end

function if_actor_has_crazy_flash(first_speaker, second_speaker)
	return flash_holder(first_speaker, second_speaker)
end

function if_actor_hasnt_crazy_flash(first_speaker, second_speaker)
	return not flash_holder(first_speaker, second_speaker)
end

function transfer_crazy_flash(first_speaker, second_speaker)
	dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "crazy_flash")
end
