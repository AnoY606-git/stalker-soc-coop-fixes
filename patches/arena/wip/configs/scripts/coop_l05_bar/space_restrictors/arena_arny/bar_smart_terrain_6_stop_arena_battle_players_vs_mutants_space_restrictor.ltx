[logic]
active 												= sr_idle@determine_cl_sv
type 												= no_save

[sr_idle@determine_cl_sv]
on_info   											= {=isServer -BAR_ARNY_ARENA_SMART_TERRAIN_DOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_DOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_DOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_DOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_PSEUDODOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_PSEUDODOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BOAR_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BOAR_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BLOODSUCKER_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BLOODSUCKER_DURING_THE_TIME_ARENA_INFO} sr_idle@sv_control %-BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD -BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD -BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD -BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD -BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD%
on_info3   											= {=isServer} sr_idle@sv_control
on_info2  											= {=isClient} sr_idle@cl_control

;server logic
[sr_idle@sv_control]
on_info    											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD}  			sr_idle@sv_start_arena_dog_dead		
on_info2   											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD}  	sr_idle@sv_start_arena_pseudodog_dead
on_info3   											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD}  			sr_idle@sv_start_arena_boar_dead	
on_info4   											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD}  	sr_idle@sv_start_arena_bloodsucker_dead
;on_info5   										= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD}  			sr_idle@sv_start_arena_non_dead	

[sr_idle@sv_start_arena_dog_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_6_arena_spawn_players_2_walk:bar_smart_terrain_6_arena_spawn_players_2_look) =forward_game_time(4)%

[sr_idle@sv_start_arena_pseudodog_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_6_arena_spawn_players_2_walk:bar_smart_terrain_6_arena_spawn_players_2_look) =forward_game_time(4) =run_postprocess(blink)%

[sr_idle@sv_start_arena_boar_dead]                                                                                                                                                                   
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD%                                                
on_game_timer  										= 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_6_arena_spawn_players_2_walk:bar_smart_terrain_6_arena_spawn_players_2_look) =forward_game_time(4) =run_postprocess(blink)%

[sr_idle@sv_start_arena_bloodsucker_dead]                                                                                                                                                            
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD%                                  
on_game_timer  										= 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_6_arena_spawn_players_2_walk:bar_smart_terrain_6_arena_spawn_players_2_look) =forward_game_time(4) =run_postprocess(blink)%

[sr_idle@sv_start_arena_non_dead]                                                                                                                                                                 
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD%                                      
on_game_timer  										= 20 | sr_idle@sv_control %=xrmpe_teleport_actors(bar_smart_terrain_6_arena_spawn_players_2_walk:bar_smart_terrain_6_arena_spawn_players_2_look) =forward_game_time(4) =run_postprocess(blink)%


;client logic
[sr_idle@cl_control]
on_info   											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD}  		  	sr_idle@cl_start_arena_dog_dead
on_info2  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD}    	sr_idle@cl_start_arena_pseudodog_dead
on_info3  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD}  		 	sr_idle@cl_start_arena_boar_dead
on_info4  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD}  	sr_idle@cl_start_arena_bloodsucker_dead
;on_info5  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD}  		 	sr_idle@cl_start_arena_non_dead

[sr_idle@cl_start_arena_dog_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@cl_control

[sr_idle@cl_start_arena_pseudodog_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@cl_control

[sr_idle@cl_start_arena_boar_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@cl_control

[sr_idle@cl_start_arena_bloodsucker_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@cl_control

[sr_idle@cl_start_arena_non_dead]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD} %-BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD%
on_game_timer  										= 20 | sr_idle@cl_control