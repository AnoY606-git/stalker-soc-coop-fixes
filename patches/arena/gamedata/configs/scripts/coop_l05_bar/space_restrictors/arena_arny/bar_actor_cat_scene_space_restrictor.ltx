[logic]
active 												= sr_idle@idle_reset
type 													= no_save

[sr_idle@idle_reset]
on_info 											= {=isServer} sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%
on_info2 											= {=isClient} sr_idle@idle_start_cat_scene

[sr_idle@idle_start_cat_scene]
on_player_inside 									= sr_idle@idle_start_cat_scene_idle %=disable_ui =run_postprocess(blink)%
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BET_SVM_INFO} 					sr_idle@idle_start_cat_scene_dead_mutant_idle %+BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%

[sr_idle@idle_start_cat_scene_idle]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO} sr_cutscene@fly

[sr_cutscene@fly]
point 												= bar_smart_terrain_6_arena_spawn_players_1_walk
look 												= bar_smart_terrain_6_arena_spawn_players_1_look
cam_effector 										= scenario_cam\coop\arena
global_cameffect 									= true
on_signal 											= cameff_end | sr_idle@idle_start_cat_scene_dead_mutant_idle %=enable_ui =run_postprocess(blink) +BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%

[sr_idle@idle_start_cat_scene_dead_mutant_idle]
on_info  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DOG_SQUAD_DEAD} 				sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%
on_info2  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_PSEUDODOG_SQUAD_DEAD} 			sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%
on_info3  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BOAR_SQUAD_DEAD} 				sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%
on_info4  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_BLOODSUCKER_SQUAD_DEAD} 		sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%
on_info5  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_NON_SQUAD_DEAD} 				sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%

on_info6  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_DOG_SQUAD_DEAD} 			sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_dtt_dog_squad)%
on_info7  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_PSEUDODOG_SQUAD_DEAD} 		sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_dtt_pseudodog_squad)%
on_info8  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_BOAR_SQUAD_DEAD} 			sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_dtt_boar_squad)%
on_info9  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_BLOODSUCKER_SQUAD_DEAD}	sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_dtt_bloodsucker_squad)%
on_info10  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_DTT_NON_SQUAD_DEAD} 			sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_dtt_bloodsucker_squad)%

on_info11  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_1_STALKER_SQUAD_DEAD} 			sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_1_bloodsucker_squad)%
on_info12  											= {+BAR_ARNY_ARENA_SMART_TERRAIN_2_BLOODSUCKER_SQUAD_DEAD} 		sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO =remove_squad(bar_arny_arena_smart_terrain_1_stalker_squad)%
; fallback: if the transient *_SQUAD_DEAD flag was consumed by another restrictor first, reset once no fight is running
on_info13 = {-BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_DOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_PSEUDODOG_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BOAR_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BLOODSUCKER_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_NON_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_DOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_PSEUDODOG_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BOAR_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_BLOODSUCKER_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_SPAWN_NON_DURING_THE_TIME_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BET_START_ARENA_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_BET_SVM_INFO} sr_idle@idle_start_cat_scene %-BAR_ARNY_ARENA_SMART_TERRAIN_START_CAT_SCENE_INFO -BAR_ARNY_ARENA_SMART_TERRAIN_START_ARENA_GO%