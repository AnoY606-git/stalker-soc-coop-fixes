-- Chapter save pack support (patch soc_savepack).
-- The save pack (SoC_COOP_saves zip) has one save per story chapter. A co-op save gives a player his saved character back only when his
-- player name matches the name stored in the save, so the gear is NOT kept in the saves. Each save carries the story flag
-- SOC_SAVEPACK_CH_<n> instead, and this server tick gives every living player the chapter's kit once (per player name, flag
-- SOC_SAVEPACK_GEAR_<NAME>), whatever his name, also players who join later. Normal games never have the flag, so nothing happens there.

local MAXCH = 17
local next_t = 0
local seen = {}          -- player id -> time_global() when first seen alive outside the lobby
local gen = 0

local function qlog(s)
	pcall(printf_msg, "%s", "[soc_savepack] " .. tostring(s))
end

local function has(f) return story_flags.has_flag(f) end

-- chapter kits: tier 1 = chapters 1-4 (Cordon to Agroprom underground), 2 = 5-11 (Dark Valley to Army Warehouses), 3 = 12-17 (Radar to the Monolith)
local GEAR = {
	[1] = {
		items = { "stalker_outfit", "wpn_ak74", "wpn_fort", "wpn_wincheaster1300", "detector_simple" },
		stacks = { { "ammo_5.45x39_fmj", 300 }, { "ammo_5.45x39_ap", 90 }, { "ammo_9x18_fmj", 90 }, { "ammo_12x70_buck", 40 },
			{ "medkit", 5 }, { "bandage", 8 }, { "antirad", 3 }, { "bread", 3 }, { "kolbasa", 3 }, { "vodka", 2 },
			{ "grenade_f1", 4 }, { "grenade_rgd5", 4 }, { "drug_coagulant", 2 } },
		money = 15000 },
	[2] = {
		items = { "scientific_outfit", "wpn_g36", "wpn_usp", "wpn_spas12", "wpn_svd", "detector_scientific", "af_medusa", "af_fireball" },
		stacks = { { "ammo_5.56x45_ss190", 300 }, { "ammo_5.56x45_ap", 120 }, { "ammo_11.43x23_fmj", 90 }, { "ammo_12x70_buck", 60 },
			{ "ammo_7.62x54_7h1", 90 }, { "medkit", 6 }, { "medkit_army", 3 }, { "bandage", 10 }, { "antirad", 4 },
			{ "drug_radioprotector", 2 }, { "bread", 4 }, { "kolbasa", 4 }, { "vodka", 2 }, { "grenade_f1", 6 }, { "grenade_rgd5", 6 },
			{ "drug_coagulant", 3 }, { "drug_booster", 1 } },
		money = 50000 },
	[3] = {
		items = { "exo_outfit", "wpn_groza", "wpn_desert_eagle", "wpn_gauss", "wpn_svd", "wpn_spas12", "wpn_rpg7", "detector_elite",
			"af_medusa", "af_fireball", "af_electra_moonlight", "af_cristall", "af_blood" },
		stacks = { { "ammo_9x39_ap", 360 }, { "ammo_9x39_sp5", 120 }, { "ammo_11.43x23_fmj", 120 }, { "ammo_gauss", 60 },
			{ "ammo_7.62x54_7h14", 120 }, { "ammo_12x70_buck", 80 }, { "ammo_og-7b", 4 }, { "medkit", 8 }, { "medkit_army", 4 },
			{ "medkit_scientic", 3 }, { "bandage", 12 }, { "antirad", 5 }, { "drug_radioprotector", 3 }, { "drug_psy_blockade", 3 },
			{ "bread", 4 }, { "kolbasa", 4 }, { "energy_drink", 4 }, { "grenade_f1", 8 }, { "grenade_rgd5", 8 }, { "drug_coagulant", 3 },
			{ "drug_booster", 2 } },
		money = 150000 },
}

function tier(n) if n <= 4 then return 1 elseif n <= 11 then return 2 else return 3 end end

-- the chapter of the loaded save pack save (highest SOC_SAVEPACK_CH_<n>), nil in a normal game
function chapter()
	for n = MAXCH, 1, -1 do
		if has("SOC_SAVEPACK_CH_" .. n) then return n end
	end
	return nil
end

local function key(a)
	return (string.gsub(string.upper(a:name()), "[^A-Z0-9]", "_"))
end

local function in_lobby(a)
	local ok, r = pcall(function()
		local l = coop_scenes.cfg.lobby
		local p = a:position()
		local dx, dz = p.x - l.x, p.z - l.z
		return (dx * dx + dz * dz) < l.r * l.r and math.abs(p.y - l.y) < 40
	end)
	return ok and r or false
end

-- ammo and consumables come as several items: one alife object each (ammo boxes of the section's box size)
local function give(a, section, count)
	local ini = system_ini()
	if not ini:section_exist(section) then qlog("missing section " .. section) return 0 end
	local per = 1
	if string.find(section, "^ammo_") then
		pcall(function() per = ini:r_u32(section, "box_size") end)
		if per == nil or per < 1 then per = 1 end
	end
	local n = math.max(1, math.ceil((count or 1) / per))
	local made = 0
	for i = 1, n do
		local ok = pcall(function() alife():create(section, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id()) end)
		if ok then made = made + 1 end
	end
	return made
end

function give_kit(a, n)
	local g = GEAR[tier(n)]
	local made = 0
	for _, s in ipairs(g.items) do made = made + give(a, s, 1) end
	for _, st in ipairs(g.stacks) do made = made + give(a, st[1], st[2]) end
	if n >= 10 then made = made + give(a, "dev_psi_protection_helmet", 1) end      -- Sakharov's helmet (from the Yantar lab on)
	pcall(function() a:give_money(g.money) end)
	return made
end

local function tick_server(now)
	if now < next_t then return end
	next_t = now + 2000
	local n = chapter()
	if n == nil then return end
	if db == nil or db.mp_actors == nil then return end
	for pid, a in pairs(db.mp_actors) do
		local okalive, alive = pcall(function() return a ~= nil and a:alive() end)
		if okalive and alive and not in_lobby(a) then
			seen[pid] = seen[pid] or now
			local fl = "SOC_SAVEPACK_GEAR_" .. key(a)
			if now - seen[pid] >= 3000 and not has(fl) then
				story_flags.give_flag(fl)                      -- once per player name, before the items (a failing item never repeats the kit)
				local made = give_kit(a, n)
				qlog(string.format("chapter %d kit for %s (%s): %d objects", n, a:name(), fl, made))
			end
		else
			seen[pid] = nil
		end
	end
end

function install()
	gen = gen + 1
	local my = gen
	pcall(function()
		level.add_call(function()
			if my ~= gen then return true end
			if OnServer() then
				local ok, err = pcall(tick_server, time_global())
				if not ok then qlog("TICKERR " .. tostring(err)) end
			end
			return false
		end, function() end)
	end)
	qlog("INSTALL gen=" .. my)
end
