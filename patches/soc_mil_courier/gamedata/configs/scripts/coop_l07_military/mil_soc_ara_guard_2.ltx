; patch soc_mil_courier: bodyguard 2 of Ara (SoC mil_Killer_specnaz, mil_ara_guard2). Runs the way to the farmstead, stands
; (guard) when Ara has arrived (flag MIL_SOC_ARA_ARRIVE) and goes back when the talk is over (flag MIL_SOC_ARA_END).
[logic]
active = walker@mil_soc_ara_guard_2_go

[walker@mil_soc_ara_guard_2_go]
path_walk = mil_smart_terrain_1_walker_4_walk
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+MIL_SOC_ARA_ARRIVE} remark@mil_soc_ara_guard_2_stand

[remark@mil_soc_ara_guard_2_stand]
anim = guard
target = story|mil_soc_pavlik
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
on_info = {+MIL_SOC_ARA_END} walker@mil_soc_ara_guard_2_leave

[walker@mil_soc_ara_guard_2_leave]
path_walk = mil_smart_terrain_1_walker_1_walk
def_state_moving = run
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
