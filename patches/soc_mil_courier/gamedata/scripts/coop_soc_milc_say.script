local function emit(id, first, second)
	local tid = "coop_soc_milc_" .. id
	pcall(function() coop_pda_phrases.phrase_speaker[tid] = SPEAKER[id] end)
	pcall(function() coop_pda_archive_sync.emit_phrase(first, second, tid) end)
end

