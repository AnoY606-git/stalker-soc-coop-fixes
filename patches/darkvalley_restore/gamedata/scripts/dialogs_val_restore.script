-- Dark Valley scammer ("fake gauss"): the original joke price is 800 roubles.
function if_actor_has_money_800(first_speaker, second_speaker)
	return getLocalActor():money() >= 800
end

function transfer_800(first_speaker, second_speaker)
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, 800)
end
