;Квест Бармена(Пробраться в лабораторию X-18: убить Борова и забрать карту)
[bar_start_sneak_into_the_x_18_lab_quest_task]
icon 									= ui_inGame2_bar_start_sneak_into_the_x_18_lab_quest_task
prior 									= 200
storyline 								= true
title 									= st_bar_start_sneak_into_the_x_18_lab_quest_task_name
descr 									= st_bar_start_sneak_into_the_x_18_lab_quest_task_descr
target 									= val_smart_terrain_4_bandit_borov
condlist_0 								= {+VAL_SMART_TERRAIN_12_BANDIT_1_SQUAD_DEAD =actor_has_item(dev_card_2)} complete %=give_task(val_start_sneak_into_the_x_18_lab_1_quest_task) +BAR_START_SNEAK_INTO_THE_X_18_LAB_QUEST_TASK_INFO%
condlist_1 								= {+VAL_SMART_TERRAIN_12_BANDIT_1_SQUAD_DEAD +BAR_START_SNEAK_INTO_THE_X_18_LAB_QUEST_TASK_INFO} complete


; SoC bar_x16_documents (patch bar_soc_quests): ONE task for the whole X16 documents job, given to every player by coop_soc_barros.script when the Barkeep
; job is accepted (flag BAR_X16_DOCUMENTS_START). Its text and its marker follow the objectives: "Talk to the scientists" (x16_yantar, level changers on the
; way, then the scientists), "Find the X16 documents" (look_for_x16_lab, after the first talk with Sakharov), "Bring the documents to the Barkeep"
; (bring_x16_documents, once the party holds them). Done when the Barkeep has them. The Rostok copy of this task (ros_start_go_to_yantar) is hidden.
[bar_start_go_to_yantar_quest_task]
icon                                    = ui_inGame2_bar_start_go_to_yantar_quest_task
prior                                   = 200
storyline                               = true
title                                   = st_bar_start_go_to_yantar_quest_task_name
descr                                   = {+YAN_X16_DOCUMENTS_GAIN} coop_soc_x16_bring_descr, {+YAN_SMART_TERRAIN_1_ECOLOG_SAHAROV_TALK_TO_THE_SAHAROV_X16_STOP_DIALOG_INFO} coop_soc_x16_look_descr, st_bar_start_go_to_yantar_quest_task_descr
target                                  = {+YAN_X16_DOCUMENTS_GAIN} bar_smart_terrain_1_stalker_barmen, {+YAN_SMART_TERRAIN_1_ECOLOG_SAHAROV_TALK_TO_THE_SAHAROV_X16_STOP_DIALOG_INFO} yan_smart_terrain_1_ecolog_saharov, {+ROS_START_GO_TO_YANTAR_QUEST_TASK_INFO} yan_smart_terrain_1_ecolog_saharov, {+BAR_START_GO_TO_YANTAR_QUEST_TASK_INFO} ros_yan_level_changer, bar_ros_level_changer
condlist_0                              = {+BAR_X16_DOCUMENTS_DONE} complete



; SoC bar_radar_deactivate (patch bar_soc_quests): given to every player when the Barkeep job "Turn off the Brain Scorcher" is accepted (flag
; BAR_DEACTIVATE_RADAR_START). ONE task up to the Radar level: the marker is the Bar exit to Military, once the party is there the Military exit to the
; Radar (it is the step the level maker had on the Military level, now hidden). Done on the Radar level, where rad_start_go_to_radar takes over.
[bar_start_go_to_military_quest_task]
icon                                    = ui_inGame2_bar_start_go_to_military_quest_task
prior                                   = 200
storyline                               = true
title                                   = st_bar_start_go_to_military_quest_task_name
descr                                   = st_bar_start_go_to_military_quest_task_descr
target                                  = {+BAR_START_GO_TO_MILITARY_QUEST_TASK_INFO} mil_rad_level_changer, bar_mil_level_changer
condlist_0                              = {+MIL_START_GO_TO_RADAR_QUEST_TASK_INFO} complete

