prior       = 455
storyline   = true
title       = st_agr_start_save_the_stalker_mole_quest_task_name
descr       = st_agr_start_save_the_stalker_mole_quest_task_descr
target      = agr_smart_terrain_7_stalker_mole
condlist_0  = {+AGR_SMART_TERRAIN_5_MILITARY_1_SQUAD_DEAD +AGR_SMART_TERRAIN_5_MILITARY_2_SQUAD_DEAD} complete
