;-- Основные квесты:
;--------------------------------------------------------------------------------------------------------------------------------------
;Квест основной(Отыскать тайник Стрелка)
[agru_start_find_the_shooter_hiding_place_task]
icon        = ui_inGame2_agru_start_find_the_shooter_hiding_place_task
prior       = 450
storyline   = true
title       = st_agru_start_find_the_shooter_hiding_place_task_name
descr       = {+AGRU_START_FIND_THE_SHOOTER_HIDING_PLACE_TASK_INFO} st_agru_start_return_to_the_surface_task_descr, {+AGRU_SOC_STASH_FOUND} coop_soc_agru_flash_descr, st_agru_start_find_the_shooter_hiding_place_task_descr
target      = {+AGRU_START_FIND_THE_SHOOTER_HIDING_PLACE_TASK_INFO} change_level_agroprom, agru_equipment_rucksack_01_case_0000
condlist_0  = {+AGRU_START_RETURN_TO_THE_SURFACE_TASK_END_INFO} complete

;Квест основной(Возвращение на поверхность)
[agru_start_return_to_the_surface_task]
icon 									= ui_inGame2_agru_start_return_to_the_surface_task
prior 									= 200
storyline 								= true
title 									= st_agru_start_return_to_the_surface_task_name
descr 									= st_agru_start_return_to_the_surface_task_descr
target 									= change_level_agroprom
condlist_0 								= {+AGRU_START_RETURN_TO_THE_SURFACE_TASK_END_INFO} complete

