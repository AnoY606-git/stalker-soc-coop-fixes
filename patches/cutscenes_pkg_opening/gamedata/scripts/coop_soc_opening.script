-------------------------------------------------------------------------------------------------------
-- Cordon opening, original Shadow of Chernobyl style (patch cutscenes_pkg_opening).
--  1. glue for the SoC start dialog of Sidorovich (escape_trader_start_dialog, experienced branch only):
--     PDA archive line for every player + the original voice lines 3 and 321 on the talking player's machine
--     (English recordings under dialogs\eng\, the original Russian ones at the stock path dialogs\ from patch soc_ru_voices)
--  2. start task chain for EVERY player: the stock xr_effects.give_task hands a task to the first player only
--     (and client_tasks.give_task_to_client returns early when the host already has it), so the other players never saw
--     "The beginning of beginnings" / "Important mission" and the flash drive tasks. A server tick gives each task to each
--     player once while its stage of the chain is open (the engine ignores a task a player already has).
-------------------------------------------------------------------------------------------------------

local MAP = "coop_l01_escape"

-------------------------------------------------------------------------------------------------------
-- 1. dialog glue
-------------------------------------------------------------------------------------------------------
local SPEAKER = { ["3"] = "npc", ["32"] = "actor", ["321"] = "npc", ["3211"] = "actor", ["32111"] = "npc", ["321111"] = "actor" }
-- per language; a missing language entry = no recording, the line stays silent
local VOICE = {
	["3"]   = { eng = "characters_voice\\dialogs\\eng\\escape_trader_start_dialog_3",
	            rus = "characters_voice\\dialogs\\escape_trader_start_dialog_3" },
	["321"] = { eng = "characters_voice\\dialogs\\eng\\escape_trader_start_dialog_321",
	            rus = "characters_voice\\dialogs\\escape_trader_start_dialog_321" },
}
local keep_snd = nil
local last = { key = nil, t = 0 }

local function qlog(s)
	pcall(printf_msg, "%s", "SOCOPEN " .. tostring(s))
	local bot = rawget(_G, "cs_bot")
	if bot and bot.log then pcall(bot.log, "SOCOPEN " .. tostring(s)) end
end

-------------------------------------------------------------------------------------------------------
-- voice language of THIS player: [client] voice_language = auto | rus | eng in his own coop_settings.ltx (patch host_settings, read on
-- every machine, also on a client). auto (the default) follows the game language (Cyrillic option texts = rus, else eng).
-- Cached per Lua VM (a level change restarts it, so an edit of the file applies at the next level start).
-------------------------------------------------------------------------------------------------------
local voice_cache = nil

local function game_lang()
	local ok, s = pcall(function() return game.translate_string("st_opt_windowed") end)
	if ok and s ~= nil then
		for i = 1, string.len(s) do
			if string.byte(s, i) >= 168 then return "rus" end
		end
	end
	return "eng"
end

local function trim(x)
	return (string.gsub(x or "", "^%s*(.-)%s*$", "%1"))
end

-- the setting as written in the file (auto | rus | eng), a bad or missing value = auto
function voice_setting()
	local raw = nil
	pcall(function() raw = coop_host_cfg.client_str("voice_language", "auto") end)
	local want = string.lower(trim(raw))
	if want == "russian" or want == "ru" then want = "rus" end
	if want == "english" or want == "en" then want = "eng" end
	if want ~= "rus" and want ~= "eng" and want ~= "auto" then
		qlog("VOICE bad voice_language '" .. tostring(raw) .. "', using auto")
		want = "auto"
	end
	return want
end

-- "rus" or "eng": the language of the voice lines this player hears
function voice_lang()
	if voice_cache ~= nil then return voice_cache end
	local want = voice_setting()
	local game_l = game_lang()
	voice_cache = (want == "auto") and game_l or want
	qlog("VOICE setting=" .. want .. " game=" .. game_l .. " -> " .. voice_cache)
	return voice_cache
end

-- tests: forget the cached choice and read the file again
function voice_reset()
	voice_cache = nil
	pcall(function() coop_host_cfg.reload() end)
end

local function say(key, first, second)
	local tid = "coop_soc_open_" .. key
	pcall(function() coop_pda_phrases.phrase_speaker[tid] = SPEAKER[key] end)
	pcall(function() coop_pda_archive_sync.emit_phrase(first, second, tid) end)
	if not OnClient() then return end
	local la = getLocalActor()
	if la == nil or first == nil or second == nil then return end
	if first:id() ~= la:id() and second:id() ~= la:id() then return end
	local now = time_global()
	if last.key == key and now - last.t < 1500 then return end
	last.key, last.t = key, now
	pcall(function() if keep_snd ~= nil and keep_snd:playing() then keep_snd:stop() end end)  -- the next phrase cuts the line still playing (as in SoC), even a silent one
	qlog("SAY " .. key)
	local lang = voice_lang()
	local v = VOICE[key] and VOICE[key][lang]
	if v == nil then qlog("NOVOICE key=" .. key .. " lang=" .. lang .. " (no recording)"); return end
	if not getFS():exist("$game_sounds$", v .. ".ogg") then qlog("NOVOICE " .. v); return end
	qlog("VOICE_PLAY key=" .. key .. " lang=" .. lang .. " path=" .. v)
	pcall(function()
		if keep_snd ~= nil and keep_snd:playing() then keep_snd:stop() end
		keep_snd = sound_object(v)
		keep_snd:play(la, 0, sound_object.s2d)
	end)
end

function say_3(a, b) say("3", a, b) end
function say_32(a, b) say("32", a, b) end
function say_321(a, b) say("321", a, b) end
function say_3211(a, b) say("3211", a, b) end
function say_32111(a, b) say("32111", a, b) end
function say_321111(a, b) say("321111", a, b) end

-------------------------------------------------------------------------------------------------------
-- 2. start task chain for every player (server)
-------------------------------------------------------------------------------------------------------
local function has(f)
	local ok, r = pcall(story_flags.has_flag, f)
	return ok and r and true or false
end

local FLESH_FLAG = "ESC_SMART_TERRAIN_1_TRADER_SIDOROVICH_FLESH_STOP_DIALOG_INFO"                 -- flash drive handed in
local JOB_FLAG = "ESC_SMART_TERRAIN_1_TRADER_SIDOROVICH_GO_TO_FOX_STOP_DIALOG_INFO"                -- Sidorovich gave the military case job (SoC)

-- task id, open while ...
local CHAIN = {
	{ id = "esc_start_main_quest_task",                 open = function() return not has("all_good_boy") end },
	{ id = "esc_start_talk_to_the_sidorovich_quest_task", open = function() return not has("ESC_START_TALK_TO_THE_SIDOROVICH_QUEST_TASK_INFO") end },
	{ id = "esc_start_find_stalker_shustry_quest_task", open = function()
		return has("ESC_START_TALK_TO_THE_SIDOROVICH_QUEST_TASK_INFO") and not has("ESC_SMART_TERRAIN_1_TRADER_SIDOROVICH_FLESH_STOP_DIALOG_INFO") end },
	{ id = "esc_start_talk_to_the_wolf_quest_task",     open = function()
		return has("ESC_START_TALK_TO_THE_SIDOROVICH_QUEST_TASK_INFO") and not has("ESC_START_TALK_TO_THE_WOLF_QUEST_TASK_INFO") end },
	-- after the flash drive, original SoC (patch cordon): "Work for the trader" until Sidorovich gave the military case job, then the two tasks
	-- of that job. Flags are shared story flags, so every player gets the same tasks whoever did the talking.
	{ id = "esc_soc_trader_job_task",                   open = function()
		return has(FLESH_FLAG) and not has(JOB_FLAG) end },
	{ id = "esc_soc_railroad_passage_task",             open = function()
		return has(JOB_FLAG) and not has("GAR_WAITING_FOR_THE_ORDER_TO_KILL_YURIK_INFO") end },
	{ id = "esc_soc_military_documents_task",           open = function()
		return has(JOB_FLAG) and not has("BAR_SMART_TERRAIN_1_TRADER_BARMEN_HAS_DOCUMENTS_AGROPROM_STOP_DIALOG_INFO") end },
}
local given = {}      -- task id -> { player id -> true }
local t_srv = 0
local installed_gen = 0
local gen = 0

-------------------------------------------------------------------------------------------------------
-- 3. only the story character starts in Sidorovich's bunker
-- The story character is the lobby portrait with the star: skin 1 of [coop_team] skins in configs\mp\cooperative_game.ltx, spawn section
-- actor_the_main_character (the other portraits spawn as actor_partner_regular). The four co-op points of level.game are in the bunker; every other
-- player is moved ONCE, right after his first spawn of a new game, to a free spot at the rookie village campfire (server side, AI nodes, spaced,
-- turned to the fire). "Once" = a per player flag (COOP_OPEN_CAMP_<NAME>, a dynamic story flag like the scene flags, kept in the save), so deaths and
-- respawns later and loaded games never move anybody; a player standing far from the bunker (an old save) is only marked, never moved; nothing
-- is done after the flash drive was handed in. Test only: the story flag COOP_OPEN_TEST_NONSTORY makes every player count as a non-story player.
-------------------------------------------------------------------------------------------------------
local STORY_SECTION = "actor_the_main_character"
local BUNKER_C = { x = -246.40, y = -24.80, z = -134.40 }          -- middle of the four bunker spawn points
local FIRE = { x = -206.90, y = -19.60, z = -140.10 }               -- esc_campfire of the rookie village
-- AI nodes of the Cordon level.ai (checked with tools\gen_camp_spots.py), 3.9 to 4.5 m from the fire (the sitting seats are at 2.3 to 2.8 m),
-- all eight neighbour nodes present, at least 4 m apart
CAMP_SPOTS = {
	{ x = -211.40, y = -19.94, z = -140.00 },
	{ x = -209.30, y = -20.15, z = -143.50 },
	{ x = -205.10, y = -20.13, z = -143.50 },
	{ x = -203.00, y = -19.99, z = -140.00 },
}
local CAMP_SETTLE_MS = 2500
local camp_seen = {}           -- actor id -> time first seen outside the lobby
local camp_moved = 0
camp_last = ""

-- the story character? (one place for the opening scene and the camp move)
function is_story(a)
	if a == nil then return false end
	if has("COOP_OPEN_TEST_NONSTORY") then return false end
	return a:section() == STORY_SECTION
end

local function camp_flag(a)
	return "COOP_OPEN_CAMP_" .. (string.gsub(string.upper(a:name()), "[^A-Z0-9]", "_"))
end

local function in_lobby(a)
	local l = coop_scenes.cfg.lobby
	local p = a:position()
	local dx, dz = p.x - l.x, p.z - l.z
	return (dx * dx + dz * dz) < l.r * l.r and math.abs(p.y - l.y) < 40
end

local function pick_spot(me)
	for i, s in ipairs(CAMP_SPOTS) do
		local v = vector():set(s.x, s.y, s.z)
		local free = true
		for pid, b in pairs(db.mp_actors) do
			if b ~= nil and b:id() ~= me:id() and b:alive() and b:position():distance_to(v) < 1.4 then free = false end
		end
		if free then return i, s end
	end
	local i = (camp_moved % #CAMP_SPOTS) + 1
	return i, CAMP_SPOTS[i]
end

local function camp_tick(now)
	if has(FLESH_FLAG) then return end                         -- the story is past the start: nobody is moved any more
	local bunker = vector():set(BUNKER_C.x, BUNKER_C.y, BUNKER_C.z)
	for pid, a in pairs(db.mp_actors) do
		if a ~= nil and a:alive() and not is_story(a) then
			local fl = camp_flag(a)
			if not has(fl) and not in_lobby(a) then
				camp_seen[pid] = camp_seen[pid] or now
				local ready = true
				pcall(function() ready = IsActorNetReady(pid) end)
				if ready and now - camp_seen[pid] >= CAMP_SETTLE_MS then
					story_flags.give_flag(fl)                  -- once per player name, whatever happens next
					if a:position():distance_to(bunker) < 8.0 then
						local i, s = pick_spot(a)
						camp_moved = camp_moved + 1
						a:set_actor_position(vector():set(s.x, s.y, s.z))
						pcall(function() a:set_actor_direction(-math.atan2(FIRE.x - s.x, FIRE.z - s.z)) end)
						camp_last = "moved " .. a:name() .. " to spot " .. i
						qlog("CAMP MOVED name=" .. a:name() .. " id=" .. tostring(pid) .. " spot=" .. i)
					else
						camp_last = "marked " .. a:name() .. " (not at the bunker, left alone)"
						qlog("CAMP MARKED name=" .. a:name() .. " id=" .. tostring(pid) .. " (far from the bunker)")
					end
				end
			end
		end
	end
end

local function tick_server(now)
	if now - t_srv < 1000 then return end
	t_srv = now
	if level.name() ~= MAP then return end
	if db.mp_actors == nil then return end
	pcall(function() coop_soc_cordon.tick_heli(now) end)   -- patch cordon: removes the level maker's helicopters after the flash drive hand-in
	local okc, errc = pcall(camp_tick, now)
	if not okc then qlog("CAMPERR " .. tostring(errc)) end
	for _, st in ipairs(CHAIN) do
		local ok, isopen = pcall(st.open)
		if ok and isopen then
			for pid, a in pairs(db.mp_actors) do
				if a ~= nil and a:alive() and (given[st.id] == nil or not given[st.id][pid]) then
					local ready = true
					pcall(function() ready = IsActorNetReady(pid) end)
					if ready then
						given[st.id] = given[st.id] or {}
						given[st.id][pid] = true
						local ok2, err = pcall(function() GiveTaskToClient(st.id, pid) end)
						qlog("GIVE_TASK " .. st.id .. " player=" .. tostring(pid) .. " " .. (ok2 and "ok" or tostring(err)))
					end
				end
			end
		end
	end
end

function install()
	gen = gen + 1
	local my = gen
	pcall(function()
		level.add_call(function()
			if my ~= gen then return true end
			if OnServer() then
				local ok, err = pcall(tick_server, time_global())
				if not ok then qlog("TICKERR " .. tostring(err)) end
			end
			return false
		end, function() end)
	end)
	qlog("INSTALL gen=" .. my)
end
