-------------------------------------------------------------------------------------------------------
-- Scene package "opening" (WP1): the original Shadow of Chernobyl start of the game.
--   intro        the opening movie for every player (skip by majority vote), new game only
--   sidor_intro  the Marked One wakes up in Sidorovich's bunker; his voiced monologue with subtitles
--   sidor_greet  Sidorovich's hello / bye lines when a player comes close / walks away (esc_trader scheme)
--   hints        the newbie hint pop-ups (jump, crouch, sprint, binoculars, relations)
--   pda_tutorial Sidorovich's voiced PDA walkthrough (offered once after his intro, yes / no)
-- All playback goes through the Scene Director (coop_scenes). Voice lines and the movie come from the
-- player's own S.T.A.L.K.E.R. install (see NOTES.md); a missing file only degrades that line to subtitles.
-------------------------------------------------------------------------------------------------------

local MAP = "coop_l01_escape"
local FLESH_FLAG = "ESC_SMART_TERRAIN_1_TRADER_SIDOROVICH_FLESH_STOP_DIALOG_INFO"
local MAIN_SECTION = "actor_the_main_character"

-- Sidorovich (m_trader, story id 3) in the Cordon bunker, from the original all.spawn
local TRADER = { x = -244.69, y = -24.96, z = -133.96 }
-- where the Marked One stands when the game starts (in front of the desk, facing Sidorovich)
BUNKER = { x = -247.30, y = -24.96, z = -133.40 }
-- the bunker door (original esc_tutorial_trigger / esc_trader_sound_zone): newbie hints start here
local DOOR = { x = -251.97, y = -19.57, z = -126.92, r = 2.5 }

-- trader_monolog2 (the Strelok briefing) is unused in the original game; the owner asked for it, so it
-- plays after trader_monolog1. Set to false for the strict original sequence.
PLAY_MONOLOG2 = true
-- show the "walk me through the PDA" yes / no box at the end of Sidorovich's intro
OFFER_PDA_TUTORIAL = true

-- voice lines: sound path (relative to gamedata\sounds, no extension), length in ms.
-- The subtitle block of line <key> is the tutorial "scn_opening_sub_<key>" (generated, see tools/).
local V = "script_replics\\trader\\"
local P = "characters_voice\\scenario\\trader\\"
local LINES = {
	monolog1 = { path = V .. "trader_monolog1", ms = 23400 },
	monolog2 = { path = V .. "trader_monolog2", ms = 29700 },
	come1b   = { path = V .. "trader1b", ms = 2800 },
	come1a   = { path = V .. "trader1a", ms = 2800 },
	hello1   = { path = V .. "trader_script1a_1", ms = 800 },
	hello2   = { path = V .. "trader_script1a_2", ms = 700 },
	hello3   = { path = V .. "trader_script1a_3", ms = 900 },
	hello4   = { path = V .. "trader_script1a_4", ms = 1200 },
	hello5   = { path = V .. "trader_script1a_5", ms = 800 },
	bye1     = { path = V .. "trader3c", ms = 1400 },
	bye2     = { path = V .. "trader_script1c_5", ms = 1400 },
	pda1     = { path = P .. "trader_tutorial_pda_1", ms = 13400 },
	pda2     = { path = P .. "trader_tutorial_pda_2", ms = 3700 },
	pda3     = { path = P .. "trader_tutorial_pda_3", ms = 5800 },
	pda4     = { path = P .. "trader_tutorial_pda_4", ms = 4600 },
	pda5     = { path = P .. "trader_tutorial_pda_5", ms = 4200 },
	pda6     = { path = P .. "trader_tutorial_pda_6", ms = 3600 },
	pda7     = { path = P .. "trader_tutorial_pda_7", ms = 6000 },
	pda9     = { path = P .. "trader_tutorial_pda_9", ms = 7200 },
	pda11    = { path = P .. "trader_tutorial_pda_11", ms = 21700 },
	pda12    = { path = P .. "trader_tutorial_pda_12", ms = 16400 },
	pda13    = { path = P .. "trader_tutorial_pda_13", ms = 13900 },
	pda14    = { path = P .. "trader_tutorial_pda_14", ms = 16400 },
	pda14_1  = { path = P .. "trader_tutorial_pda_14_1", ms = 5000 },
	pda15    = { path = P .. "trader_tutorial_pda_15", ms = 9400 },
	pda15_1  = { path = P .. "trader_tutorial_pda_15_1", ms = 28200 },
}
local PDA_ORDER = { "pda1", "pda2", "pda3", "pda4", "pda5", "pda6", "pda7", "pda9", "pda11", "pda12", "pda13", "pda14", "pda14_1", "pda15", "pda15_1" }

-------------------------------------------------------------------------------------------------------
-- helpers (both server and client)
-------------------------------------------------------------------------------------------------------
local function olog(s)
	pcall(printf_msg, "%s", "SCENE opening " .. tostring(s))
	local bot = rawget(_G, "cs_bot")
	if bot and bot.log then pcall(bot.log, "SCENE opening " .. tostring(s)) end
end

local function sound_exists(path)
	local ok, r = pcall(function() return getFS():exist("$game_sounds$", path .. ".ogg") end)
	return ok and r and true or false
end

-- steps that show the subtitle block of a line and play its voice (or, without the audio file, just
-- keep the subtitles on screen for the nominal length)
local function say(steps, key)
	local L = LINES[key]
	local have = sound_exists(L.path)
	steps[#steps + 1] = { ["do"] = "fn", fn = function(e) olog("SAY " .. key .. " audio=" .. tostring(have)) end }
	steps[#steps + 1] = { ["do"] = "tutorial", name = "scn_opening_sub_" .. key, wait = false }
	if have then
		steps[#steps + 1] = { ["do"] = "snd2d", path = L.path, wait = true, cap_ms = L.ms + 4000 }
	else
		steps[#steps + 1] = { ["do"] = "wait", ms = L.ms }
	end
	steps[#steps + 1] = { ["do"] = "tutorial_stop" }
end

local function place_marked_one(env)
	local a = env.actor
	if a == nil or a:section() ~= MAIN_SECTION then return end
	local tr = vector():set(TRADER.x, TRADER.y, TRADER.z)
	local me = vector():set(BUNKER.x, BUNKER.y, BUNKER.z)
	if a:position():distance_to(me) < 1.5 then return end
	a:set_actor_position(me)
	local dx, dz = tr.x - me.x, tr.z - me.z
	pcall(function() a:set_actor_direction(-math.atan2(dx, dz)) end)
	olog("PLACED actor=" .. tostring(env.actor_id))
end

local function far_from_bunker(a)
	if a == nil then return false end
	local me = vector():set(BUNKER.x, BUNKER.y, BUNKER.z)
	return a:position():distance_to(me) > 6.0
end

-------------------------------------------------------------------------------------------------------
-- server helpers
-------------------------------------------------------------------------------------------------------
local pending = {}      -- actor id -> true: Marked One that has not had Sidorovich's intro yet
local greet = {}        -- actor id -> { hello=bool, bye=bool }
local first_out = nil

local function nm(a)
	return (string.gsub(string.upper(a:name()), "[^A-Z0-9]", "_"))
end

local function trader_pos()
	local ok, p = pcall(function()
		local o = alife():story_object(3)
		return o and o.position
	end)
	if ok and p then return p end
	return vector():set(TRADER.x, TRADER.y, TRADER.z)
end

local function in_lobby(a)
	local l = coop_scenes.cfg.lobby
	local p = a:position()
	local dx, dz = p.x - l.x, p.z - l.z
	return (dx * dx + dz * dz) < l.r * l.r and math.abs(p.y - l.y) < 40
end

local function gstate(id)
	local g = greet[id]
	if g == nil then g = { hello = false, bye = false }; greet[id] = g end
	return g
end

-------------------------------------------------------------------------------------------------------
-- 1. the opening movie
-------------------------------------------------------------------------------------------------------
coop_scenes.register{
	id = "intro", kind = "movie", level = MAP, once = true,
	tutorial = "soc_intro", length_ms = 185000, grace_ms = 20000, skip = "majority", settle_ms = 8000,
	need = { tex = { "intro\\intro_stalker.ogm" }, snd = { "characters_voice\\scenario\\video\\intro_stalker_l.ogg" } },
	-- the Marked One is moved to the bunker while the movie covers the screen
	steps = function(var, env)
		return {
			{ ["do"] = "ui_off" },
			{ ["do"] = "fn", fn = place_marked_one },
			{ ["do"] = "tutorial", name = "soc_intro", wait = true },
			{ ["do"] = "ui_on" },
		}
	end,
	-- no movie / audio on this install: no screen change, only the placement
	fallback = function(var, env)
		return { { ["do"] = "fn", fn = place_marked_one } }
	end,
	-- new game start: somebody is in the world, everybody left the lobby (or 45 s passed)
	trigger = function(ctx)
		if ctx.flag(FLESH_FLAG) then return false end
		local out, lobby = 0, 0
		for _, a in ipairs(ctx.players()) do
			if in_lobby(a) then lobby = lobby + 1 else out = out + 1 end
		end
		if out == 0 then first_out = nil; return false end
		first_out = first_out or ctx.now
		return lobby == 0 or ctx.now - first_out > 45000
	end,
}

-- the story character: remember who still needs Sidorovich's intro (once per player name, persisted by the core)
coop_scenes.on_first_spawn(function(actor, ctx)
	if actor:section() == MAIN_SECTION then
		pending[actor:id()] = true
		olog("PENDING actor=" .. tostring(actor:id()) .. " name=" .. actor:name())
	end
end)

-------------------------------------------------------------------------------------------------------
-- 2. Sidorovich's intro for the Marked One (targeted)
-------------------------------------------------------------------------------------------------------
local function build_sidor_intro(env)
	local steps = {}
	local a = env.actor
	if far_from_bunker(a) then
		-- late joiner / respawned story character: hide the jump with a black card
		steps[#steps + 1] = { ["do"] = "ui_off" }
		steps[#steps + 1] = { ["do"] = "tutorial", name = "soc_black", wait = false }
		steps[#steps + 1] = { ["do"] = "fn", fn = place_marked_one }
		steps[#steps + 1] = { ["do"] = "wait", ms = 1500 }
		steps[#steps + 1] = { ["do"] = "tutorial_stop" }
		steps[#steps + 1] = { ["do"] = "ui_on" }
	else
		steps[#steps + 1] = { ["do"] = "fn", fn = place_marked_one }
	end
	steps[#steps + 1] = { ["do"] = "wait", ms = 5000 }                       -- mob_trader@new_start_wait
	say(steps, "monolog1")                                                   -- new_start_intro2
	if PLAY_MONOLOG2 then
		steps[#steps + 1] = { ["do"] = "wait", ms = 1200 }
		say(steps, "monolog2")
	end
	steps[#steps + 1] = { ["do"] = "tutorial", name = "scn_opening_tip_talk", wait = false }  -- new_start_intro3
	steps[#steps + 1] = { ["do"] = "wait", ms = 5000 }
	steps[#steps + 1] = { ["do"] = "tutorial_stop" }
	say(steps, "come1b")                                                     -- new_start_intro4
	steps[#steps + 1] = { ["do"] = "wait", ms = 2500 }
	if OFFER_PDA_TUTORIAL then
		steps[#steps + 1] = { ["do"] = "fn", fn = function(e) offer_pda_tutorial_client() end }
	end
	return steps
end

coop_scenes.register{
	id = "sidor_intro", kind = "sequence", level = MAP, once = false, skip = "none",
	length_ms = 80000, grace_ms = 20000, settle_ms = 3000,
	steps = function(var, env) return build_sidor_intro(env) end,
	trigger = function(ctx)
		if ctx.flag(FLESH_FLAG) then pending = {}; return false end
		if not coop_scenes.played("intro") then return false end
		for id, _ in pairs(pending) do
			local a = db.mp_actors and db.mp_actors[id]
			if a ~= nil and a:alive() and not in_lobby(a) then
				pending[id] = nil
				local g = gstate(id)
				g.hello, g.bye = true, false       -- esc_trader_hello_played is set by the intro
				coop_scenes.request("sidor_intro", nil, { target = id })
				olog("SIDOR_INTRO_REQ actor=" .. tostring(id))
				return false
			end
		end
		return false
	end,
}

-------------------------------------------------------------------------------------------------------
-- 3. hello / bye (mob_trader@new_hello, mob_trader@new_bye)
-------------------------------------------------------------------------------------------------------
local last_greet = 0
coop_scenes.register{
	id = "sidor_greet", kind = "sequence", level = MAP, once = false, skip = "none",
	length_ms = 3500, grace_ms = 8000, settle_ms = 3000,
	steps = function(var, env)
		local steps = {}
		if var == "bye" then
			say(steps, "bye" .. math.random(1, 2))
		else
			say(steps, "hello" .. math.random(1, 5))
		end
		return steps
	end,
	trigger = function(ctx)
		if not coop_scenes.played("intro") or ctx.now - last_greet < 6000 then return false end
		local tp = trader_pos()
		for _, a in ipairs(ctx.players()) do
			local id = a:id()
			local d = a:position():distance_to(tp)
			local g = gstate(id)
			if d >= 12 then
				g.hello, g.bye = false, false
			elseif d <= 3 and not g.hello then
				g.hello = true
				last_greet = ctx.now
				coop_scenes.request("sidor_greet", "hello", { target = id })
				return false
			elseif d >= 5 and g.hello and not g.bye then
				g.bye = true
				last_greet = ctx.now
				coop_scenes.request("sidor_greet", "bye", { target = id })
				return false
			end
		end
		return false
	end,
}

-------------------------------------------------------------------------------------------------------
-- 4. newbie hints (esc_tutorial.ltx): jump, crouch, sprint, binoculars, relations
-------------------------------------------------------------------------------------------------------
coop_scenes.register{
	id = "hints", kind = "sequence", level = MAP, once = false, skip = "none",
	length_ms = 72000, grace_ms = 20000, settle_ms = 3000,
	steps = function(var, env)
		return {
			{ at = 1000,  ["do"] = "tutorial", name = "scn_opening_hint_jump", wait = true },
			{ at = 8000,  ["do"] = "tutorial", name = "scn_opening_hint_crouch", wait = true },
			{ at = 15000, ["do"] = "tutorial", name = "scn_opening_hint_sprint", wait = true },
			{ at = 35000, ["do"] = "tutorial", name = "scn_opening_hint_binoc", wait = true },
			{ at = 55000, ["do"] = "tutorial", name = "scn_opening_hint_relations", wait = true },
		}
	end,
	trigger = function(ctx)
		if not coop_scenes.played("intro") then return false end
		local dv = vector():set(DOOR.x, DOOR.y, DOOR.z)
		for _, a in ipairs(ctx.players()) do
			local f = "COOP_OPENING_HINTS_" .. nm(a)
			if not ctx.flag(f) and a:position():distance_to(dv) <= DOOR.r then
				story_flags.give_flag(f)
				coop_scenes.request("hints", nil, { target = a:id() })
				olog("HINTS_REQ actor=" .. tostring(a:id()))
				return false
			end
		end
		return false
	end,
}

-------------------------------------------------------------------------------------------------------
-- 5. Sidorovich's PDA walkthrough (voiced pages + subtitles; the original PDA highlight windows are SoC UI)
-------------------------------------------------------------------------------------------------------
coop_scenes.register{
	id = "pda_tutorial", kind = "sequence", level = MAP, once = false, skip = "any",
	length_ms = 175000, grace_ms = 20000, settle_ms = 1000,
	steps = function(var, env)
		local steps = {}
		for _, k in ipairs(PDA_ORDER) do
			say(steps, k)
			steps[#steps + 1] = { ["do"] = "wait", ms = 300 }
		end
		return steps
	end,
}

-- client: the yes / no box (same pattern as coop_map_vote.prompt_client)
local offered = false
function offer_pda_tutorial_client()
	if offered or test_no_offer then return end
	offered = true
	local ok, err = pcall(function()
		ui_test_dialog.show_callbacks("message_box_yes_no", game.translate_string("scn_opening_pda_offer"),
			function() game_cl.executeFunctionOnServer("coop_opening_pda_yes") end,
			function() end)
	end)
	if not ok then olog("OFFERERR " .. tostring(err)) end
end

-- server: the player said yes
function on_pda_yes(initiator_id)
	if initiator_id == nil then return end
	local ok = coop_scenes.request("pda_tutorial", nil, { target = initiator_id })
	olog("PDA_YES actor=" .. tostring(initiator_id) .. " queued=" .. tostring(ok))
end

pcall(function()
	game_sv.coop_opening_pda_yes = function(i) coop_scn_opening.on_pda_yes(i) end
end)
