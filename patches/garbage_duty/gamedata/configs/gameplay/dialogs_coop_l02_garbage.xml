        <phrase_list>
            <phrase id="0">
                <text />
                <next>2</next>
                <next>1</next>
                <next>3</next>
            </phrase>
            <!-- the boar wave is over and a player killed a boar (SoC gar_kill_boars objective 2): the commander thanks him, the report completes the task, the reward is his -->
