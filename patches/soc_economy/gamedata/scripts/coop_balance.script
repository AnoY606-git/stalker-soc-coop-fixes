-- Co-op balance for Shadow of COOP (server only). Settings: configs\misc\coop_balance.ltx
--  A. on_npc_hit(): extra damage of players' weapons against NPCs and mutants (global multiplier; v1.4 fix: it used to heal).
--  B. trader_ammo(): trader ammo stock grows with the number of players (called from trade_manager.update).
-- Both are inert when the multiplier is <= 1 / the factor is 0.

local cache = nil
local in_extra = false

local defaults = { player_damage_mult = 1.5, log = true, ammo_per_extra_player = 1.0, max_players = 4 }

function cfg()
	if cache ~= nil then return cache end
	local c = {}
	for k, v in pairs(defaults) do c[k] = v end
	pcall(function()
		local ini = ini_file("misc\\coop_balance.ltx")
		if ini == nil then return end
		local function rd(sect, key)
			if ini:section_exist(sect) and ini:line_exist(sect, key) then
				if type(defaults[key]) == "boolean" then c[key] = ini:r_bool(sect, key)
				else c[key] = ini:r_float(sect, key) end
			end
		end
		rd("damage", "player_damage_mult"); rd("damage", "log")
		rd("ammo", "ammo_per_extra_player"); rd("ammo", "max_players")
	end)
	-- the host's coop_settings.ltx (patch host_settings) overrides the db values; server only, a missing file changes nothing
	pcall(function()
		c.player_damage_mult = coop_host_cfg.num("damage", "player_damage_mult", c.player_damage_mult)
		c.log = coop_host_cfg.bool("damage", "log", c.log)
		c.ammo_per_extra_player = coop_host_cfg.num("ammo", "ammo_per_extra_player", c.ammo_per_extra_player)
		c.max_players = coop_host_cfg.num("ammo", "max_players", c.max_players)
	end)
	cache = c
	clog("coop_balance config: damage_mult=%.2f ammo_per_extra_player=%.2f max_players=%d",
		c.player_damage_mult, c.ammo_per_extra_player, c.max_players)
	return c
end

-- drops the cached settings (coop_host_cfg.reload, tests)
function host_reload()
	cache = nil
end

function clog(fmt, ...)
	local s = string.format(fmt, ...)
	pcall(function() printf_msg("[CBAL] %s", s) end)
	if cache ~= nil and cache.log == false then return end
	pcall(function()
		local f = io.open(getFS():update_path("$logs$", "cb.log"), "a")
		if f then
			f:write(string.format("[%8.1f] %s\n", time_global() / 1000, s))
			f:close()
		end
	end)
end

-- same counting as player_scaling.player_count(): living db.mp_actors, never more than the server's player slots
function player_count()
	local n = 0
	if db.mp_actors ~= nil then
		for _, a in pairs(db.mp_actors) do
			local ok, alive = pcall(function() return a:alive() end)
			if ok and alive then n = n + 1 end
		end
	end
	local ok, g = pcall(function() return get_players_count() end)
	if ok and g ~= nil then
		if IsDedicatedServer() then g = g - 1 end
		if g >= 0 and n > g then n = g end
	end
	return n
end

-----------------------------------------------------------------------------------------------------------------
-- A. damage
-----------------------------------------------------------------------------------------------------------------
-- Measured in game (2026-10-20): the stalker hit callback runs BEFORE the engine applies the hit (the monster one AFTER), and the script property
-- `health` is RELATIVE in this engine (obj.health = x adds x to the health; vanilla does db.actor.health = -0.05 to hurt).
-- The first version of this function wrote obj.health = hp - extra, i.e. it HEALED the target by almost its whole health on every
-- player hit and cancelled the hit (a chest shot with a 1.5 multiplier left the bandit at full health).
-- So the extra damage is applied as a negative number, after the engine has applied the hit, from the health that was really lost:
-- extra = lost * (mult - 1). That also keeps bone scale (head x3, limbs less), armor and immunities in the multiplied hit.
local pending = {}          -- npc id -> { hp0, t0, t1, who_id }: hits of one burst, handled together when the burst ends
local tick_on = false

local function apply_extra(id, p)
	local obj = level.object_by_id(id)
	if obj == nil or not obj:alive() then return end
	local c = cfg()
	local hp = obj.health
	if hp == nil then return end
	local lost = p.sum or (p.hp0 - hp)                           -- monsters: sum of the callback amounts (see on_npc_hit)
	if lost <= 0.0005 then return end                          -- the hit did nothing (armor, friendly, already counted)
	local extra = lost * (c.player_damage_mult - 1.0)
	if extra <= 0 then return end
	if hp - extra > 0.005 then
		obj.health = -extra                                 -- relative: plain health loss, no armor re-applied, no new callback
	else
		-- the extra damage is lethal: kill with a real hit so death, loot and kill credit run normally
		local who = p.who_id and level.object_by_id(p.who_id) or nil
		in_extra = true
		local h = hit()
		if who ~= nil then h.draftsman = who end
		h.type = hit.fire_wound
		h.direction = who ~= nil and obj:position():sub(who:position()) or vector():set(0, 0, 1)
		h.power = 10
		h.impulse = 0
		pcall(function() h:bone(IsStalker(obj) and "bip01_spine" or "pelvis") end)
		obj:hit(h)
		in_extra = false
	end
end

local tick_t = 0

-- runs every frame while hits are pending; returns true (and unregisters itself) when nothing is pending any more
local function pending_tick()
	local now = time_global()
	tick_t = now
	for id, p in pairs(pending) do
		if now - p.t1 >= 120 or now - p.t0 >= 600 then
			pending[id] = nil
			local ok, err = pcall(apply_extra, id, p)
			in_extra = false
			if not ok then clog("apply_extra error: %s", tostring(err)) end
		end
	end
	return next(pending) == nil
end

local function tick_done()
	tick_on = false
end

-- Called first thing from the hit callbacks of the NPC binder (xr_motivator) and the monster binder (bind_monster).
function on_npc_hit(obj, amount, who, bone_index)
	if in_extra then return end
	if type(bone_index) ~= "number" then return end          -- fake hit from death_callback
	if amount == nil or amount <= 0 or who == nil or obj == nil then return end
	if db.mp_actors == nil or db.mp_actors[who:id()] == nil then return end   -- only players' hits
	if not OnServer() then return end                         -- the multiplier is the host's setting: clients never apply it
	local c = cfg()
	if c.player_damage_mult <= 1.0 then return end
	if who:id() == obj:id() then return end
	local ok, err = pcall(function()
		if not obj:alive() or obj:invulnerable() then return end
		local now = time_global()
		-- Stalkers: the callback runs BEFORE the hit is applied and amount is hit power x 100, so the loss is measured afterwards.
		-- Monsters (bind_monster, measured with a dog): the callback runs AFTER the hit and amount is the health that was lost
		-- (0.4139 for 1.0 -> 0.5861), so the amounts are summed instead.
		local mon = false
		pcall(function() mon = IsMonster(obj) and true or false end)
		local p = pending[obj:id()]
		if p ~= nil and mon then p.sum = (p.sum or 0) + amount end
		if p == nil then
			pending[obj:id()] = { hp0 = obj.health, sum = mon and amount or nil, t0 = now, t1 = now, who_id = who:id() }
			if not tick_on or now - tick_t > 3000 then      -- (re)register; the second test heals a call dropped by a level change
				tick_on = true
				tick_t = now
				level.add_call(pending_tick, tick_done)
			end
		else
			p.t1 = now                                       -- same burst: hp0 stays, the whole burst is multiplied once
			p.who_id = who:id()
		end
	end)
	if not ok then clog("on_npc_hit error: %s", tostring(err)) end
end

-----------------------------------------------------------------------------------------------------------------
-- B. trader ammo
-----------------------------------------------------------------------------------------------------------------
-- trade_manager.update calls this right after the vanilla npc:buy_supplies(): the stock for 1 player was just delivered.
function on_supplied(npc, tt, sect)
	tt.cb_sect = sect
	tt.cb_given = 1
	tt.cb_next = nil
end

-- Called from trade_manager.update on every tick; cheap (throttled to once per 3 s per trader).
-- For every player above the number already served, the "<supplies section>_ammo" section (the ammo lines of that supplies
-- section, see the trader ltx files) is delivered ammo_per_extra_player times.
function trader_ammo(npc, tt)
	if tt.cb_given == nil or tt.cb_sect == nil or tt.cb_sect ~= tt.current_buy_supplies then return end
	local now = time_global()
	if tt.cb_next ~= nil and now < tt.cb_next then return end
	tt.cb_next = now + 3000
	if not OnServer() then return end
	local c = cfg()
	if c.ammo_per_extra_player <= 0 then return end
	local n = player_count()
	if n > c.max_players then n = math.floor(c.max_players) end
	if n <= tt.cb_given then return end
	local ammo_sect = tt.cb_sect .. "_ammo"
	local ok, err = pcall(function()
		if not tt.config:section_exist(ammo_sect) then return end
		for p = tt.cb_given + 1, n do
			local whole = math.floor(c.ammo_per_extra_player)
			local frac = c.ammo_per_extra_player - whole
			for i = 1, whole do npc:buy_supplies(tt.config, ammo_sect) end
			if frac > 0 and math.random() < frac then npc:buy_supplies(tt.config, ammo_sect) end
			clog("trader %s: extra ammo for player %d (%s)", npc:name(), p, ammo_sect)
		end
	end)
	if not ok then clog("trader_ammo error: %s", tostring(err)) end
	tt.cb_given = n
end
