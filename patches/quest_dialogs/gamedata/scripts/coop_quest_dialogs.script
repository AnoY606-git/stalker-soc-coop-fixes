local function any_open(alts)
	for _, alt in ipairs(alts) do
		local ok = true
		for _, f in ipairs(alt.has) do if not story_flags.has_flag(f) then ok = false break end end
		if ok then
			for _, f in ipairs(alt.dont) do if story_flags.has_flag(f) then ok = false break end end
		end
		if ok then return true end
	end
	return false
end

