; Sidorovich's bunker door (sliding door between the entrance corridor and his room).
;
; The old logic closed the door by the zone esc_trader_door_space_restrictor. That box stands at the TOP of the entrance stairs
; (-255.6, -19.6, -127.3), about 10 m and 5 m above the door. `open` went back to `close` ("on_actor_not_in_zone") in the same frame
; unless a player stood in that little box, so a player at the door could not get it to stay open.
; Now the whole bunker is the zone: esc_sr_no_weapon_space_restrictor (box 17 x 6 x 12 m around both rooms and the corridor, stairs bottom
; included). The door opens when ANY player is inside the bunker (or presses use) and closes when NO player is inside any more, so it
; is always passable from both sides, for every player, and never closes on somebody who is in the doorway.
; `locked` and `near` are not used any more; they stay (like the old file had them) so a save that still stores one of them loads.

[logic]
active = ph_door@close

[ph_door@locked]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_info = ph_door@close

[ph_door@close]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@open
on_actor_in_zone = esc_sr_no_weapon_space_restrictor | ph_door@open

[ph_door@near]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@open
on_actor_in_zone = esc_sr_no_weapon_space_restrictor | ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_actor_not_in_zone = esc_sr_no_weapon_space_restrictor | ph_door@close
