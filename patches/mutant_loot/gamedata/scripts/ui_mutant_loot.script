---------------------------------------------------------------------------------------------------
-- Window "Search corpse" for mutant parts (patch mutant_loot). Client side. See mutant_loot.script.
---------------------------------------------------------------------------------------------------

local wnd = nil

class "mloot_wnd" (CUIScriptWnd)

function mloot_wnd:__init(cid) super()
	self.cid = cid
	self.parts = mutant_loot.parts_on(cid)
	self.t = 0
	self:InitControls()
end

function mloot_wnd:__finalize()
end

local function set_icon(st, part)
	pcall(function()
		local ini = system_ini()
		local gx = ini:r_float(part, "inv_grid_x")
		local gy = ini:r_float(part, "inv_grid_y")
		local gw = ini:r_float(part, "inv_grid_width")
		local gh = ini:r_float(part, "inv_grid_height")
		st:InitTexture("ui\\ui_icon_equipment")
		st:SetTextureRect(Frect():set(gx * 50, gy * 50, (gx + gw) * 50, (gy + gh) * 50))
		st:SetStretchTexture(true)
	end)
end

function mloot_wnd:InitControls()
	local xml = CScriptXmlInit()
	xml:ParseFile("mutant_loot_wnd.xml")
	xml:InitWindow("mutant_loot_wnd", 0, self)
	self:SetAutoDelete(true)

	self.icon = xml:InitStatic("mutant_loot_wnd:row_icon", self)
	self.txt = xml:InitTextWnd("mutant_loot_wnd:row_text", self)
	self.empty = xml:InitTextWnd("mutant_loot_wnd:empty_text", self)

	self.btn_take = xml:Init3tButton("mutant_loot_wnd:btn_take", self)
	self:Register(self.btn_take, "btn_take")
	self.btn_close = xml:Init3tButton("mutant_loot_wnd:btn_close", self)
	self:Register(self.btn_close, "btn_close")
	self:AddCallback("btn_take", ui_events.BUTTON_CLICKED, self.OnTake, self)
	self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, self.OnClose, self)
	self:Refresh()
end

function mloot_wnd:Refresh()
	local n = #self.parts
	if n > 0 then
		local names = {}
		for i = 1, n do
			local nm = system_ini():r_string(self.parts[i], "inv_name")
			names[#names + 1] = game.translate_string(nm)
		end
		self.txt:SetText(table.concat(names, ", "))
		set_icon(self.icon, self.parts[1])
		self.icon:Show(true)
		self.txt:Show(true)
		self.empty:Show(false)
		self.btn_take:Show(true)
	else
		self.icon:Show(false)
		self.txt:Show(false)
		self.empty:Show(true)
		self.btn_take:Show(false)
	end
end

-- the corpse content is shared state: if another player takes the part while this window is open, the list updates
function mloot_wnd:Update()
	CUIScriptWnd.Update(self)
	local now = time_global()
	if now - self.t < 400 then return end
	self.t = now
	local p = mutant_loot.parts_on(self.cid)
	if #p ~= #self.parts then
		self.parts = p
		self:Refresh()
	end
end

function mloot_wnd:OnTake()
	if #self.parts > 0 then
		mutant_loot.request_take(self.cid)
	end
	self:OnClose()
end

function mloot_wnd:OnClose()
	self:HideDialog()
	wnd = nil
end

function mloot_wnd:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false then
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.DIK_ESCAPE then
				self:OnClose()
			end
		end
	end
	return res
end

-- open the window for corpse <cid> (returns the window; tests call it too)
function open(cid)
	if wnd ~= nil then
		pcall(function() wnd:HideDialog() end)
		wnd = nil
	end
	wnd = ui_mutant_loot.mloot_wnd(cid)
	wnd:ShowDialog(true)
	return wnd
end

function close()
	if wnd ~= nil then
		pcall(function() wnd:HideDialog() end)
		wnd = nil
	end
end

function current()
	return wnd
end
