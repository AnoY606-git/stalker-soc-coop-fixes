<window>
	<mutant_loot_wnd anchor="mid-center" width="700" height="380">
		<auto_static x="0" y="0" width="700" height="380" stretch="1">
			<texture>ui_inGame2_servers_list_frame_back</texture>
		</auto_static>
		<auto_static anchor="top-center" x="0" y="-60" width="549" height="92" stretch="1">
			<texture>ui_ingame_big_red_header_bcg</texture>
			<text y="-4" font="din_next36_bold" outline="1" vert_align="c" align="c">st_mutant_loot_title</text>
		</auto_static>

		<row_icon x="50" y="80" width="120" height="120" stretch="1"/>
		<row_text x="190" y="120" width="460" height="40">
			<text font="din_next36_bold" color="yellow_mpe" outline="1" vert_align="c" align="l"/>
		</row_text>
		<empty_text x="0" y="130" width="700" height="40">
			<text font="din_next36_bold" outline="1" vert_align="c" align="c">st_mutant_loot_empty</text>
		</empty_text>

		<btn_take x="140" y="300" width="200" height="42" stretch="1">
			<texture>ui_ingame_default_button</texture>
			<text font="din_next17_bold" align="c">st_mutant_loot_take</text>
			<text_color>
				<e color="ui_white"/>
				<t color="ui_white"/>
				<d color="dark_mpe"/>
				<h color="ui_white"/>
			</text_color>
			<sound_h>interface\selector_button</sound_h>
			<sound_t>interface\select_button</sound_t>
		</btn_take>
		<btn_close x="360" y="300" width="200" height="42" stretch="1">
			<texture>ui_ingame_default_button</texture>
			<text font="din_next17_bold" align="c">st_mutant_loot_close</text>
			<text_color>
				<e color="ui_white"/>
				<t color="ui_white"/>
				<d color="dark_mpe"/>
				<h color="ui_white"/>
			</text_color>
			<sound_h>interface\selector_button</sound_h>
			<sound_t>interface\select_button</sound_t>
		</btn_close>
	</mutant_loot_wnd>
</window>
