-------------------------------------------------------------------------------------------------------
function sar_bad_final_monolith_info(actor, npc)
	if xr_conditions.actor_in_zone(actor, npc, {"sar_monolith_space_restrictor"})
		then
		story_flags.give_flag("SAR_BAD_FINAL_MONOLITH_INFO")
	end
end

-------------------------------------------------------------------------------------------------------

-- CNPP shake fix: stc_surge/stc_stop_surge use this id for the looping surge_shock.ppe, but it was never defined.
surge_shock_pp_eff = 20080402

-- task_guard patch: give_task on a dedicated server with no spawned player crashed at getLocalActor():get_task (nil).
local task_guard_orig_give_task = give_task
function give_task(actor, obj, p)
	if p ~= nil and p[1] ~= nil and OnServer() and IsDedicatedServer() and (db.mp_actors == nil or next(db.mp_actors) == nil) then
		coop_task_guard.hold(p[1])
		return
	end
	return task_guard_orig_give_task(actor, obj, p)
end
coop_task_guard.install()


-------------------------------------------------------------------------------------------------------
-- Hunter's family rifle (patch hunter_shotgun): SoC l06_rostok all.spawn item "hunters_toz" (story id
-- bar_hunter_toz, id 502), position taken unchanged from the original level.spawn. The node and game
-- vertex are those of the nearest object of the level (ros_surprise_box_001_0002), the original has none.
-------------------------------------------------------------------------------------------------------
function spawn_hunter_rifle(actor, npc)
	if OnClient() then
		return
	end
	alife():create("wpn_toz34_m2", vector():set(-256.500000, -4.800000, 90.100000), 64680, 1257)
end
