-------------------------------------------------------------------------------------------------------
-- ˜˜˜˜:
-------------------------------------------------------------------------------------------------------
-- CNPP shake: runs on the machine that owns the local player only (a dedicated server has no db.actor and
-- used to raise an error every wave). Every effector is removed before it is added again, so repeated waves
-- never stack effectors, and the two camera effectors have their own ids (the second one used to replace the first).
function stc_surge(actor, npc)
    if db.actor == nil then
        return
    end
    level.remove_cam_effector(20080501)
    level.remove_cam_effector(20080503)
    level.remove_pp_effector(surge_shock_pp_eff)
    level.set_weather_fx("fx_surge_day_3_stancia")
    xr_sound.set_sound_play(db.actor:id(), "blowout_begin")
    level.add_cam_effector("camera_effects\\shell_shock.anm", 20080501, false, "")
    level.add_cam_effector("camera_effects\\earthquake_00.anm", 20080503, false, "")
    level.add_pp_effector("surge_shock.ppe", surge_shock_pp_eff, true)
end

function stc_stop_surge(actor, npc)
    if db.actor == nil then
        return
    end
    level.set_weather("[default]",false)
    level.remove_cam_effector(20080501)
    level.remove_cam_effector(20080503)
    level.remove_pp_effector(surge_shock_pp_eff)
end

