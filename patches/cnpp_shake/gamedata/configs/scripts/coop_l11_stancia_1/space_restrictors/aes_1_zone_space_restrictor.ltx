[logic]
active 												= sr_idle@nil

; CNPP-1 (coop_l11_stancia_1): NO camera shake. The mod called stc_surge when a player entered the zone (a looping shell-shock / earthquake
; effect that never stopped); v1.4.2 made it waves (15 s shake, 45 s calm). The original Shadow of Chernobyl has no shaking on this level,
; so nothing is started any more (v1.4.3, maintainer FOSTER: "remove the shaking at the NPP").
; The old section names stay, because a save made with an earlier patch stores the active section by name: they end the effect once
; (stc_stop_surge removes the camera and post-process effectors, it does nothing on a dedicated server) and go to the empty section.
[sr_idle@start_surge_idle]
on_player_inside  									= sr_idle@nil

[sr_idle@surge_on]
on_info 											= sr_idle@nil %=stc_stop_surge%

[sr_idle@surge_off]
on_info 											= sr_idle@nil %=stc_stop_surge%

[sr_idle@nil]
