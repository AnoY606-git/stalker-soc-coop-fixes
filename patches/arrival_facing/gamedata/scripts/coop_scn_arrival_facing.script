-- Arrival facing: after a level transition the players must look INTO the level, not at the level changer they came through.
-- Cause: the MP client spawns turned 180 degrees from the dest_direction of the level changer (measured: Dark Valley dest yaw -3.11, client yaw 0),
-- so every changer whose dest_direction was meant to look into the level makes the players look back at the changer.
-- Generic fix without touching all.spawn: on every client, shortly after arrival, if the player stands near a changer of this
-- level and looks towards it, turn them to the opposite direction (once). Loaded by the Scene Director (coop_scn_*.script).
-- Positions of the level changers per level come from the mod's all.spawn (plus val_esc_level_changer of darkvalley_restore).

local LC = {
	["coop_l01_escape"] = {{"esc_gar_level_changer",26.1,16.6,685.7}},
	["coop_l02_garbage"] = {{"gar_esc_level_changer",35.7,0.4,-313.2}, {"gar_agr_level_changer",-271.3,3.9,-16.2}, {"gar_bar_level_changer",-17.1,0.5,279.0}, {"gar_val_level_changer",295.1,3.9,149.3}},
	["coop_l03_agroprom"] = {{"agr_gar_level_changer",283.9,0.0,9.6}, {"agr_agru_level_changer",-76.7,-3.5,12.7}},
	["coop_l03_agroprom_underground"] = {{"agru_agr_level_changer",-130.1,0.7,-139.1}},
	["coop_l04_darkvalley"] = {{"val_esc_level_changer",-44.6,0.4,-548.8}, {"val_gar_level_changer",-179.4,2.8,-187.4}, {"val_x18_level_changer",118.4,-2.9,-255.9}},
	["coop_l04_x18"] = {{"x18_val_level_changer",-3.5,11.1,-13.3}},
	["coop_l05_bar"] = {{"bar_gar_level_changer",373.3,14.5,-205.5}, {"bar_ros_level_changer",43.6,-0.5,141.5}, {"bar_mil_level_changer",56.3,-0.0,237.7}},
	["coop_l06_rostok"] = {{"ros_bar_level_changer",39.4,-0.6,139.5}, {"ros_yan_level_changer",-77.2,-15.8,-210.9}},
	["coop_l07_military"] = {{"mil_bar_level_changer",-340.5,-25.3,38.8}, {"mil_rad_level_changer",75.6,-13.7,401.8}},
	["coop_l08_x16"] = {{"x16_yan_1_level_changer",150.2,39.9,-13.3}, {"x16_yan_2_level_changer",-120.6,16.4,-17.2}},
	["coop_l08_yantar"] = {{"yan_ros_level_changer",213.8,6.5,-247.0}, {"yan_x16_level_changer",2.1,-5.1,-14.0}},
	["coop_l09_radar"] = {{"rad_level_changer_1",147.6,-9.3,-34.2}, {"rad_level_changer_2",382.1,-33.6,160.0}},
	["coop_l09_x10"] = {{"x10_level_changer",-0.4,-7.5,-86.5}},
	["coop_l10_pripyat"] = {{"pri_level_changer",31.1,1.1,420.4}},
	["coop_l11_stancia_1"] = {{"aes_1_level_changer",367.9,-1.3,36.7}},
	["coop_l11_sarcofag"] = {{"sar_level_changer",71.1,16.8,28.4}},
	["coop_l11_control_monolith"] = {{"con_level_changer",36.4,-34.6,20.6}},
}

local NEAR = 30.0          -- m, only arrivals this close to a changer are touched
local TOWARD = 100.0       -- deg, looking within this angle of the changer counts as "facing it"
local WINDOW = 14000       -- ms after arrival during which the fix may apply
local SETTLE = 800         -- ms, wait until the engine has placed the actor
local MOVED = 4.0          -- m, the player walked away by himself: leave him alone

local S = { gen = 0, level = nil, t0 = 0, p0 = nil, state = 0, sign = 1, want = 0, tries = 0, last = 0, info = "" }

local function wrap(a)
	while a > math.pi do a = a - 2 * math.pi end
	while a < -math.pi do a = a + 2 * math.pi end
	return a
end

local function nearest(ln, p)
	local best, bd
	for _, c in ipairs(LC[ln] or {}) do
		local dx, dz = c[2] - p.x, c[4] - p.z
		local d = math.sqrt(dx * dx + dz * dz)
		if not bd or d < bd then bd = d; best = { c[1], math.atan2(dx, dz) } end
	end
	return best, bd
end

local function yaw_of(a)
	local d = a:direction()
	return math.atan2(d.x, d.z)
end

local function tick(now)
	local a = db.actor
	if a == nil or not a:alive() then return end
	local ln = level.name()
	if ln ~= S.level then
		S.level = ln; S.t0 = now; S.p0 = nil; S.state = 0; S.tries = 0
	end
	if S.state >= 2 then return end
	local dt = now - S.t0
	if dt < SETTLE then return end
	if dt > WINDOW then
		S.state = 2
		return
	end
	local p = a:position()
	if S.p0 == nil then S.p0 = { x = p.x, z = p.z } end
	local mx, mz = p.x - S.p0.x, p.z - S.p0.z
	if math.sqrt(mx * mx + mz * mz) > MOVED then S.state = 2 return end
	local c, d = nearest(ln, p)
	if c == nil or d > NEAR then S.state = 2 return end
	local f = yaw_of(a)
	if S.state == 0 then
		if math.abs(wrap(f - c[2])) * 180 / math.pi > TOWARD then
			S.state = 2                                  -- already looks into the level
			return
		end
		-- the engine hands the client the dest_direction turned by 180 degrees: undo that (= the original SoC facing),
		-- and if that still looks at the changer, look straight away from it
		S.want = wrap(f + math.pi)
		if math.abs(wrap(S.want - c[2])) * 180 / math.pi <= TOWARD then S.want = wrap(c[2] + math.pi) end
		S.info = string.format("level=%s changer=%s dist=%.1f before_yaw=%.2f bearing=%.2f", ln, c[1], d, f, c[2])
		a:set_actor_direction(S.sign * S.want)
		S.state = 1; S.last = now; S.tries = 1
		return
	end
	-- state 1: the turn reaches the server object late (measured ~4 s); only log the result, never flip
	if now - S.last < 6000 then return end
	S.state = 2
	S.info = S.info .. string.format(" after_yaw=%.2f", f)
	pcall(function() printf("[arrival_facing] %s", S.info) end)
end

function info()
	return string.format("state=%d sign=%d tries=%d %s", S.state, S.sign, S.tries, S.info)
end

local function install()
	S.gen = S.gen + 1
	local gen = S.gen
	pcall(function()
		level.add_call(function()
			if gen ~= S.gen then return true end
			local now = time_global()
			if now - S.last < 250 and S.state == 1 then return false end
			pcall(tick, now)
			return false
		end, function() end)
	end)
end

install()
