; Bar loudspeaker (see patches/bar_speaker/NOTES.md): the SoC dolg_speech theme. One pool, random entry, never the same entry twice in a row
; (select_next_sound), a random 5-15 s pause after every entry (idle), like SoC's ph_sound min_idle 5000 / max_idle 15000.
; Files 1-9: the add-on's barman/Duty announcements; files 10-12: the SoC tracks megafon_music_1..3 (patch bar_speaker ships them).
[bar_dolg_speech]
type = 3d
path = characters_voice\scenario\coop_l05_bar\bar_megafon_speech_
shuffle = rnd
idle = 5,15,100
sync = true

; patch soc_music: original SoC Bar radio track (sounds\characters_voice\scenario\bar\radio_music\bar_radio_soc_1.ogg)
[bar_radio_soc]
type = 3d
path = characters_voice\scenario\bar\radio_music\bar_radio_soc_
shuffle = rnd
idle = 0,0,100
sync = true
