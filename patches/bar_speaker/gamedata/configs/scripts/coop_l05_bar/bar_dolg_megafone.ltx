[logic]
active = sr_idle

; Original SoC (ph_sound@idle, theme dolg_speech): random Duty announcement or music, 5-15 s pause, repeat.
; Here: announcement, pause, announcement, pause, music track k, pause, ... through all tracks.
[sr_idle]
on_info = {-bar_player_music_info -bar_megafon_alarm} sr_idle@s0 %=play_sound(bar_megafon_speech)%

[sr_idle@s0]
on_signal = sound_end | sr_idle@p0
on_info = {+bar_player_music_info} sr_idle, {+bar_megafon_alarm} sr_idle

[sr_idle@p0]
on_timer = 5000 | sr_idle@s1 %=play_sound(bar_megafon_speech)%
on_info = {+bar_player_music_info} sr_idle, {+bar_megafon_alarm} sr_idle

