[logic]
active = sr_idle

; Original SoC: the ONE Duty loudspeaker (ph_sound@idle: snd = dolg_speech, min_idle = 5000, max_idle = 15000) plays a random entry of its
; list, never the same twice in a row, then pauses 5-15 s and repeats. Here that is the sound theme bar_dolg_speech (random entry, idle = 5,15):
; the theme itself enforces the pause, this section only asks for a sound every 0.5 s. The two extra loudspeaker objects the add-on added
; (bar_dolg_megafone_0000 / _0001, same cfg) stay silent: SoC has one speaker, and three speakers talking out of phase is not SoC.
[sr_idle]
on_info = {=check_npc_name(megafone$)} sr_idle@wait %=play_sound(bar_dolg_speech)%

[sr_idle@wait]
on_timer = 500 | sr_idle

; Sections of the earlier versions (saved games keep the name of the active section; a name that no longer exists crashes the load):
; each one just goes back to sr_idle.

[sr_idle@s0]
on_info = sr_idle

[sr_idle@p0]
on_info = sr_idle

