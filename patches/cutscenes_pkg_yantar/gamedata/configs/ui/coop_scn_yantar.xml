<!-- coop_scn_yantar: tutorial blocks of scene package "yantar". -->

	<!-- Doctor dream. Original SoC tutorial yantar_dream: video intro\dream_doctor with sound characters_voice\scenario\video\dream_doctor (_l/_r pair).
	     Own block because the core soc_dream_doctor wrapper has no <sound>. Files come from the owner's SoC install (not shipped). -->
	<scn_yantar_dream>
		<play_each_item>1</play_each_item>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
			<auto_static start_time="0" length_sec="6" x="512" y="740" width="500" height="24" alignment="c" stretch="1"><text font="letterica18" r="200" g="200" b="200" a="200" align="c">scn_core_skip_hint</text></auto_static>
		</global_wnd>
		<item type="video">
			<sound>characters_voice\scenario\video\dream_doctor</sound>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<video_wnd x="0" y="0" width="1024" height="768" stretch="1">
				<texture x="0" y="1" width="512" height="286">intro\dream_doctor</texture>
			</video_wnd>
		</item>
	</scn_yantar_dream>

	<scn_yantar_card>
		<play_each_item>1</play_each_item>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
			<auto_static x="12" y="350" width="1000" height="40" alignment="c" stretch="1"><text font="letterica18" r="200" g="200" b="200" a="255" align="c">scn_yantar_card</text></auto_static>
			<auto_static start_time="0" length_sec="6" x="512" y="740" width="500" height="24" alignment="c" stretch="1"><text font="letterica18" r="200" g="200" b="200" a="200" align="c">scn_core_skip_hint</text></auto_static>
		</global_wnd>
		<item>
			<length_sec>120</length_sec>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<grab_input>0</grab_input>
			<main_wnd/>
		</item>
	</scn_yantar_card>

	<!-- HD copies of the movie blocks above (Full HD movies of the SoC Enhanced Edition Cutscenes pack, textures\intro_hd\NAME.ogm). Same window, sound and timing; only the video file and the source rectangle (1919x1076 of the 1920x1080 frame) differ. coop_scenes.hd_tutorial() starts the block NAME_hd instead of NAME when the movie file exists. -->

	<scn_yantar_dream_hd>
		<play_each_item>1</play_each_item>
		<global_wnd x="0" y="0" width="1024" height="768">
			<auto_static x="0" y="0" width="1024" height="768" stretch="1"><texture>intro\intro_back</texture></auto_static>
			<auto_static start_time="0" length_sec="6" x="512" y="740" width="500" height="24" alignment="c" stretch="1"><text font="letterica18" r="200" g="200" b="200" a="200" align="c">scn_core_skip_hint</text></auto_static>
		</global_wnd>
		<item type="video">
			<sound>characters_voice\scenario\video\dream_doctor</sound>
			<pause_state>off</pause_state>
			<can_be_stopped>off</can_be_stopped>
			<function_on_stop>coop_scenes.client_movie_stopped</function_on_stop>
			<video_wnd x="0" y="0" width="1024" height="768" stretch="1">
				<texture x="0" y="1" width="1919" height="1076">intro_hd\dream_doctor</texture>
			</video_wnd>
		</item>
	</scn_yantar_dream_hd>
