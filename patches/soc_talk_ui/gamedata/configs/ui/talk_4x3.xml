<w>
	<!-- Shadow of Chernobyl talk window (GSC Game World original layout, see NOTES.md). Header art, titles, portraits: scripts/soc_talk_ui.script + soc_talk_info.xml -->
	<main anchor="mid-center" x="0" y="0" width="1200" height="900">
		<answers_bcg x="256" y="137" width="703" height="431" stretch="1">
			<texture>ui_talk_dialogue_back</texture>
		</answers_bcg>
		<auto_static x="256" y="683" width="703" height="131" stretch="1">
			<texture>ui_talk_dialogue2_back</texture>
		</auto_static>
		<auto_static x="256" y="814" width="703" height="47" stretch="1">
			<texture>ui_talk_dialogue2_e</texture>
		</auto_static>
	</main>

	<button x="508" y="842" width="184" height="56" stretch="1" hint="ui_st_exit_hint">
		<texture>ui_button_main01</texture>
		<text font="graffiti22" align="c">ui_st_trade</text>
		<text_color>
			<e r="238" g="153" b="26"/>
			<t r="255" g="179" b="83"/>
			<d r="120" g="90" b="40"/>
			<h r="255" g="179" b="83"/>
		</text_color>
	</button>

	<answers_list x="295" y="139" width="637" height="420" always_show_scroll="1"/>
	<questions_list x="291" y="685" width="641" height="125" always_show_scroll="0"/>

	<question_item x="0" y="0" width="641" height="23" min_height="15">
		<num_text x="0" y="3" width="12" height="23">
			<text font="letterica16" color="ui_2"/>
		</num_text>
		<content_text x="22" y="2" width="596" height="23">
			<text font="letterica16" color="ui_2" align="l" complex_mode="1"/>
			<text_color>
				<t r="231" g="168" b="12"/>
				<e color="ui_2"/>
				<h color="ui_1"/>
			</text_color>
		</content_text>
	</question_item>

	<other_answer_item x="0" y="0" width="637" height="0" min_height="15" bottom_footer="4">
		<name_caption x="0" y="2" width="615" height="12">
			<text font="graffiti22" color="ui_7" complex_mode="0"/>
		</name_caption>
		<content_text x="26" y="26" width="590" height="12" complex_mode="1">
			<text font="letterica16" color="ui_8"/>
		</content_text>
	</other_answer_item>

	<actor_answer_item x="0" y="0" width="637" height="0" min_height="15" bottom_footer="8">
		<name_caption x="0" y="2" width="615" height="12">
			<text font="graffiti22" color="ui_lime" complex_mode="0"/>
		</name_caption>
		<content_text x="26" y="26" width="590" height="12" complex_mode="1">
			<text font="letterica16" color="ui_2"/>
		</content_text>
	</actor_answer_item>

	<iconed_answer_item x="0" y="0" width="637" height="0" min_height="35" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="96" y="0" width="537" height="34" complex_mode="1">
			<text font="letterica16" color="ui_1"/>
		</content_text>
		<msg_icon x="26" y="3" width="63" height="34" stretch="1"/>
	</iconed_answer_item>

	<simple_answer_item x="0" y="0" width="637" height="0" min_height="15" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="78" y="0" width="550" height="34" complex_mode="1">
			<text font="letterica16" color="ui_1"/>
		</content_text>
		<msg_icon x="32" y="3" width="0" height="0"/>
	</simple_answer_item>

	<iconed_trade_info x="0" y="0" width="637" height="0" min_height="23" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="84" y="2" width="545" height="23" complex_mode="1">
			<text font="letterica16" color="ui_8"/>
		</content_text>
		<msg_icon x="26" y="0" width="43" height="23" stretch="1"/>
	</iconed_trade_info>
</w>
