----------------------------------------------------------------------------------------------------
-- stash_loot: breakable boxes (physic_destroyable_object) drop the loot they had in the original SoC.
-- The add-on's spawn lost the [drop_box] custom_data (and the level default of the SoC loot
-- tables is 0 for the coop_* level names), so boxes broke empty. Data: stash_loot_data.script
-- (generated by patches/stash_loot/tools/gen_stash_loot.py). The loot is created on the SERVER only,
-- once per box (spawned[] guard), so every client simply sees the items replicate.
--
-- Boxes that had no loot data in SoC (stash_loot_kinds.script, tools/gen_box_kinds.py) follow FOSTER's
-- rule from configs/misc/box_loot.ltx: a wooden box rolls wood_chance when it breaks, a metal box
-- metal_chance; a plain inventory box rolls inventory_chance once (flag SBOX_<name>, never again, also
-- not after a reload). A successful roll gives items_per_roll consumables or ammo of the level's tier.
----------------------------------------------------------------------------------------------------

local spawned = {}      -- [object id] = true once its loot was created (server)
results = {}            -- [object name] = { "section", ... } what the last break created (used by tests)
stats = { w = { rolls = 0, wins = 0 }, m = { rolls = 0, wins = 0 }, i = { rolls = 0, wins = 0 } }   -- fallback rolls (server)

----------------------------------------------------------------------------------------------------
-- configs\misc\box_loot.ltx
----------------------------------------------------------------------------------------------------
local conf = nil

local function words(s)
	local t = {}
	for w in string.gfind(s, "([%w_%-%.]+)") do table.insert(t, w) end
	return t
end

-- the host's coop_settings.ltx (patch host_settings, sections box_loot and box_loot_items) overrides box_loot.ltx; server only
local function host_num(sec, key, v)
	local ok, r = pcall(function() return coop_host_cfg.num(sec, key, v) end)
	if ok and r ~= nil then return r end
	return v
end

local function host_bool(sec, key, v)
	local ok, r = pcall(function() return coop_host_cfg.bool(sec, key, v) end)
	if ok and r ~= nil then return r end
	return v
end

-- drops the cached settings (coop_host_cfg.reload, tests)
function host_reload()
	conf = nil
end

local function load_conf()
	local ini = ini_file("misc\\box_loot.ltx")
	local sys = system_ini()
	local function num(sec, key, def)
		local v = def
		if ini:section_exist(sec) and ini:line_exist(sec, key) then v = ini:r_float(sec, key) end
		return host_num("box_loot", key, v)
	end
	local function flag(sec, key, def)
		local v = def
		if ini:section_exist(sec) and ini:line_exist(sec, key) then v = ini:r_bool(sec, key) end
		return host_bool("box_loot", key, v)
	end
	local c = {
		enabled   = flag("settings", "enabled", true),
		breakable = flag("settings", "fallback_breakable", true),
		inventory = flag("settings", "fallback_inventory", true),
		chance    = { w = num("settings", "wood_chance", 30), m = num("settings", "metal_chance", 50), i = num("settings", "inventory_chance", 50) },
		per_roll  = math.floor(num("settings", "items_per_roll", 1)),
		ammo_min  = math.floor(num("settings", "ammo_min", 10)),
		ammo_max  = math.floor(num("settings", "ammo_max", 30)),
		items     = {},   -- { section, weight } (consumables; "ammo" = a pick from the level's tier)
		total     = 0,
		tiers     = {},   -- [level] = { ammo sections }
	}
	if ini:section_exist("consumables") then
		for i = 0, ini:line_count("consumables") - 1 do
			local ok, id, val = ini:r_line("consumables", i, "", "")
			local w = tonumber(val)
			if w then w = host_num("box_loot_items", id, w) end
			if ok and w and w > 0 and (id == "ammo" or sys:section_exist(id)) then
				table.insert(c.items, { id, w })
				c.total = c.total + w
			end
		end
	end
	local function tier(sec)
		local l = {}
		if ini:section_exist(sec) and ini:line_exist(sec, "ammo") then
			for _, a in ipairs(words(ini:r_string(sec, "ammo"))) do
				if sys:section_exist(a) then table.insert(l, a) end
			end
		end
		return l
	end
	c.tiers.default = tier("tier_default")
	for _, lv in ipairs({ "coop_l01_escape", "coop_l02_garbage", "coop_l03_agroprom", "coop_l03_agroprom_underground", "coop_l04_darkvalley",
		"coop_l04_x18", "coop_l05_bar", "coop_l06_rostok", "coop_l07_military", "coop_l08_x16", "coop_l08_yantar", "coop_l09_radar",
		"coop_l09_x10", "coop_l10_pripyat", "coop_l11_stancia_1", "coop_l11_stancia_2", "coop_l11_control_monolith", "coop_l11_sarcofag" }) do
		local l = tier("tier_" .. lv)
		if #l > 0 then c.tiers[lv] = l end
	end
	return c
end

function config()
	if conf == nil then
		local ok, res = pcall(load_conf)
		if ok then
			conf = res
		else
			printf("stash_loot: box_loot.ltx failed: %s", tostring(res))
			conf = { enabled = false, items = {}, total = 0, tiers = { default = {} }, chance = {}, per_roll = 0, ammo_min = 1, ammo_max = 1, breakable = false, inventory = false }
		end
	end
	return conf
end

----------------------------------------------------------------------------------------------------
local function entry_from_ini(obj)
	local ini = obj:spawn_ini()
	if not (ini and ini:section_exist("drop_box")) then return nil end
	if ini:line_exist("drop_box", "items") then
		local t, out = {}, {}
		for name in string.gfind(ini:r_string("drop_box", "items"), "([%w_%-%.]+)%p*") do
			table.insert(t, name)
		end
		local k = 1
		while k <= #t do
			local cnt = 1
			if t[k + 1] and tonumber(t[k + 1]) then
				cnt = tonumber(t[k + 1])
				table.insert(out, t[k]); table.insert(out, cnt)
				k = k + 2
			else
				table.insert(out, t[k]); table.insert(out, 1)
				k = k + 1
			end
		end
		return { i = out }
	end
	local c = "def_box"
	if ini:line_exist("drop_box", "community") then c = ini:r_string("drop_box", "community") end
	return { c = c }
end

function entry_for(obj)
	local lv = stash_loot_data.boxes[level.name()]
	local e = lv and lv[obj:name()]
	if e then return e end
	e = entry_from_ini(obj)
	if e then return e end
	-- no SoC data: FOSTER's rule (box_loot.ltx)
	local kinds = stash_loot_kinds.kinds[level.name()]
	local k = kinds and kinds[obj:name()]
	if k then
		local c = config()
		if c.enabled and ((k == "i" and c.inventory) or (k ~= "i" and c.breakable)) then return { k = k } end
	end
	return nil
end

-- called from bind_physic_object.init: true when the box got the stash binder
function try_bind(obj)
	local e = entry_for(obj)
	if not e then return false end
	local ini = obj:spawn_ini()
	if ini and ini:section_exist("logic") then
		local a = ini:line_exist("logic", "active") and ini:r_string("logic", "active") or nil
		if a and a ~= "nil" then return false end	-- a real logic scheme: leave it to the generic binder
	end
	db.storage[obj:id()] = {}
	obj:bind_object(stash_box_binder(obj, e))
	return true
end

local function pos_near(obj)
	local p = obj:position()
	local v = vector():set(0, 0, 0)
	v.x = p.x + math.random(-30, 30) / 100
	v.z = p.z + math.random(-30, 30) / 100
	v.y = p.y + math.random(30, 50) / 100
	return v
end

local function make(obj, section, list)
	alife():create(section, pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id())
	table.insert(list, section)
end

-- FOSTER's rule: one weighted pick from box_loot.ltx. parent = inventory box id (item goes inside), nil = on the ground
local function pick_item(c)
	local r = math.random() * c.total
	for _, it in ipairs(c.items) do
		r = r - it[2]
		if r <= 0 then return it[1] end
	end
	return c.items[#c.items] and c.items[#c.items][1] or nil
end

-- the decision only (no objects created): { win = bool, picks = { {section, rounds or nil}, ... } }
function plan(kind)
	local c = config()
	local out = { win = false, picks = {} }
	local chance = c.chance[kind] or 0
	if not (c.total > 0 and math.random(100) <= chance) then return out end
	out.win = true
	for n = 1, c.per_roll do
		local sec = pick_item(c)
		if sec == "ammo" then
			local tier = c.tiers[level.name()] or c.tiers.default
			sec = tier[math.random(#tier)]
			if sec then table.insert(out.picks, { sec, math.random(c.ammo_min, math.max(c.ammo_min, c.ammo_max)) }) end
		elseif sec then
			table.insert(out.picks, { sec })
		end
	end
	return out
end

function roll_fallback(obj, e, parent)
	local list = {}
	local s = stats[e.k]
	local p = plan(e.k)
	s.rolls = s.rolls + 1
	if not p.win then return list, false end
	s.wins = s.wins + 1
	for _, it in ipairs(p.picks) do
		local sec, number = it[1], it[2]
		if number then
			create_ammo(sec, parent and obj:position() or pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id(), parent or 65535, number)
			table.insert(list, sec .. "*" .. number)
		else
			if parent then
				alife():create(sec, obj:position(), obj:level_vertex_id(), obj:game_vertex_id(), parent)
			else
				alife():create(sec, pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id())
			end
			table.insert(list, sec)
		end
	end
	return list, true
end

-- SoC xr_box.ph_item_box:spawn_items, same rolls, tables from stash_loot_data
function spawn_loot(obj, e)
	local d = stash_loot_data
	local list = {}
	if e.k then
		list = roll_fallback(obj, e, nil)
		return list
	end
	if e.i then
		for k = 1, #e.i, 2 do
			for n = 1, e.i[k + 1] do make(obj, e.i[k], list) end
		end
		return list
	end
	local diff = 2
	pcall(function() diff = level.get_game_difficulty() end)
	local cnt = d.count[diff] or d.count[1]
	local mul = d.level_mul[level.name()] or {}
	for section, rnd in pairs(d.comm[e.c] or d.comm.def_box) do
		local c, m = cnt[section], mul[section]
		local number = 0
		if c and m then
			local lo, hi = math.floor(c[1] * m), math.floor(c[2] * m)
			if hi < lo then hi = lo end
			number = math.ceil(math.random(lo, hi))
		end
		if d.ammo[section] then
			if number > 0 and math.random(100) <= rnd then
				create_ammo(section, pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id(), 65535, number)
				table.insert(list, section .. "*" .. number)
			end
		else
			for n = 1, number do
				if math.random(100) <= rnd then make(obj, section, list) end
			end
		end
	end
	return list
end

function on_death(obj, e)
	if not OnServer() then return end
	if e.k == "i" then return end
	local id = obj:id()
	if spawned[id] then return end
	spawned[id] = true
	local list = spawn_loot(obj, e)
	results[obj:name()] = list
	printf("stash_loot: box '%s' (id %d) dropped %d: %s", obj:name(), id, #list, table.concat(list, ","))
end

-- plain inventory box: roll once, server only, remembered in a shared story flag (never refilled on reload)
function fill_inventory(obj, e)
	if not OnServer() then return end
	local flag = string.upper("SBOX_" .. obj:name())   -- give_flag upper-cases, has_flag does not
	if story_flags.has_flag(flag) then return end
	story_flags.give_flag(flag)
	local list = roll_fallback(obj, e, obj:id())
	results[obj:name()] = list
	printf("stash_loot: inventory box '%s' (id %d) filled with %d: %s", obj:name(), obj:id(), #list, table.concat(list, ","))
end

----------------------------------------------------------------------------------------------------
class "stash_box_binder" (object_binder)
function stash_box_binder:__init(obj, entry) super(obj)
	self.entry = entry
	self.cb = false
	self.filled = false
end

function stash_box_binder:net_spawn(data)
	if not object_binder.net_spawn(self, data) then return false end
	db.add_obj(self.object)
	return true
end

function stash_box_binder:update(delta)
	object_binder.update(self, delta)
	if self.entry.k == "i" then
		if not self.filled then
			self.filled = true
			fill_inventory(self.object, self.entry)
		end
		return
	end
	if not self.cb then
		self.cb = true
		self.object:set_callback(callback.death, stash_box_binder.death_callback, self)
	end
end

function stash_box_binder:death_callback(victim, who)
	on_death(self.object, self.entry)
end

function stash_box_binder:net_destroy()
	db.del_obj(self.object)
	db.storage[self.object:id()] = nil
	object_binder.net_destroy(self)
end
