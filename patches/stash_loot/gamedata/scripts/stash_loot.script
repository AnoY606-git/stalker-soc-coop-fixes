----------------------------------------------------------------------------------------------------
-- stash_loot: breakable boxes (physic_destroyable_object) drop the loot they had in the original SoC.
-- The add-on's spawn lost most of the [drop_box] custom_data (and the level default of the SoC loot
-- tables is 0 for the coop_* level names), so boxes broke empty. Data: stash_loot_data.script
-- (generated by patches/stash_loot/tools/gen_stash_loot.py). The loot is created on the SERVER only,
-- once per box (spawned[] guard), so every client simply sees the items replicate.
----------------------------------------------------------------------------------------------------

local spawned = {}      -- [object id] = true once its loot was created (server)
results = {}            -- [object name] = { "section", ... } what the last break created (used by tests)

local function entry_from_ini(obj)
	local ini = obj:spawn_ini()
	if not (ini and ini:section_exist("drop_box")) then return nil end
	if ini:line_exist("drop_box", "items") then
		local t, out = {}, {}
		for name in string.gfind(ini:r_string("drop_box", "items"), "([%w_%-.\]+)%p*") do
			table.insert(t, name)
		end
		local k = 1
		while k <= #t do
			local cnt = 1
			if t[k + 1] and tonumber(t[k + 1]) then
				cnt = tonumber(t[k + 1])
				table.insert(out, t[k]); table.insert(out, cnt)
				k = k + 2
			else
				table.insert(out, t[k]); table.insert(out, 1)
				k = k + 1
			end
		end
		return { i = out }
	end
	local c = "def_box"
	if ini:line_exist("drop_box", "community") then c = ini:r_string("drop_box", "community") end
	return { c = c }
end

function entry_for(obj)
	local lv = stash_loot_data.boxes[level.name()]
	local e = lv and lv[obj:name()]
	if e then return e end
	return entry_from_ini(obj)
end

-- called from bind_physic_object.init: true when the box got the stash binder
function try_bind(obj)
	local e = entry_for(obj)
	if not e then return false end
	local ini = obj:spawn_ini()
	if ini and ini:section_exist("logic") then
		local a = ini:line_exist("logic", "active") and ini:r_string("logic", "active") or nil
		if a and a ~= "nil" then return false end	-- a real logic scheme: leave it to the generic binder
	end
	db.storage[obj:id()] = {}
	obj:bind_object(stash_box_binder(obj, e))
	return true
end

local function pos_near(obj)
	local p = obj:position()
	local v = vector():set(0, 0, 0)
	v.x = p.x + math.random(-30, 30) / 100
	v.z = p.z + math.random(-30, 30) / 100
	v.y = p.y + math.random(30, 50) / 100
	return v
end

local function make(obj, section, list)
	alife():create(section, pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id())
	table.insert(list, section)
end

-- SoC xr_box.ph_item_box:spawn_items, same rolls, tables from stash_loot_data
function spawn_loot(obj, e)
	local d = stash_loot_data
	local list = {}
	if e.i then
		for k = 1, #e.i, 2 do
			for n = 1, e.i[k + 1] do make(obj, e.i[k], list) end
		end
		return list
	end
	local diff = 2
	pcall(function() diff = level.get_game_difficulty() end)
	local cnt = d.count[diff] or d.count[1]
	local mul = d.level_mul[level.name()] or {}
	for section, rnd in pairs(d.comm[e.c] or d.comm.def_box) do
		local c, m = cnt[section], mul[section]
		local number = 0
		if c and m then
			local lo, hi = math.floor(c[1] * m), math.floor(c[2] * m)
			if hi < lo then hi = lo end
			number = math.ceil(math.random(lo, hi))
		end
		if d.ammo[section] then
			if number > 0 and math.random(100) <= rnd then
				create_ammo(section, pos_near(obj), obj:level_vertex_id(), obj:game_vertex_id(), 65535, number)
				table.insert(list, section .. "*" .. number)
			end
		else
			for n = 1, number do
				if math.random(100) <= rnd then make(obj, section, list) end
			end
		end
	end
	return list
end

function on_death(obj, e)
	if not OnServer() then return end
	local id = obj:id()
	if spawned[id] then return end
	spawned[id] = true
	local list = spawn_loot(obj, e)
	results[obj:name()] = list
	printf("stash_loot: box '%s' (id %d) dropped %d: %s", obj:name(), id, #list, table.concat(list, ","))
end

----------------------------------------------------------------------------------------------------
class "stash_box_binder" (object_binder)
function stash_box_binder:__init(obj, entry) super(obj)
	self.entry = entry
	self.cb = false
end

function stash_box_binder:net_spawn(data)
	if not object_binder.net_spawn(self, data) then return false end
	db.add_obj(self.object)
	return true
end

function stash_box_binder:update(delta)
	object_binder.update(self, delta)
	if not self.cb then
		self.cb = true
		self.object:set_callback(callback.death, stash_box_binder.death_callback, self)
	end
end

function stash_box_binder:death_callback(victim, who)
	on_death(self.object, self.entry)
end

function stash_box_binder:net_destroy()
	db.del_obj(self.object)
	db.storage[self.object:id()] = nil
	object_binder.net_destroy(self)
end
