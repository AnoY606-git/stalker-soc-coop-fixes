-- Repeatable side quests for Shadow of COOP (restores the SoC task_manager "idle_time" refresh and the
-- eliminate_lager / defend_lager / kill_stalker / find_item job types).
-- Server authoritative. All state lives in story flags (saved with the game + synced to every client, incl. late joiners):
--   RQ_<TASK>_C<n>  repeat cycle number (absent = cycle 0)      RQ_<TASK>_A<n>  "task given in cycle n" marker
--   RQ_<TASK>_R<m>  refresh at game minute m (since 2000-01-01)  RQ_<TASK>_T<m>  accepted at game minute m (generated jobs)
--   RQ_<TASK>_S<id> spawned squad ids                            RQ_<TASK>_I<id> spawned item id      RQ_<TASK>_P<id> map spot object
-- Two families, both in misc/coop_repeat_quests.ltx:
--   legacy (no "kind"): the mod's own sq_* quests. Cycle 0 is run by the mod's one-shot restrictors, from cycle 1 on this script
--                       gives the task and re-creates the target squads itself.
--   generated (kind = gen_kill | gen_camp | gen_defend | gen_find): this script spawns the targets (generic simulation squads
--                       or an item) when the dialog sets the accept flag, watches them, and sets the done / fail flag.
--   fetch (kind = gen_fetch): bring an artifact / a mutant part. Nothing is spawned and there is no map spot; the task is given, the hand-in dialog
--                       (coop_rq_dialogs.script) takes the item from the talking player, pays that player and sets the done flag.
-- The mod's own sq_* quests (generic task menu "I need work") are no longer offered or refreshed: their entries were removed from the ltx.

cooldown_override_min = nil   -- tests only
local TICK_MS = 2000
local GRACE_MS = 8000
local last_tick = 0
local last_clock = 0
local ini = nil
quests = nil
known_actors = nil            -- module level so tests can forget an actor
local epoch = nil
local reward_synced = false
local SPOT = {gen_kill = "red_location", gen_camp = "red_location", gen_defend = "red_location", gen_find = "green_location"}

-- The host's coop_settings.ltx (patch host_settings, section repeat_quests: cooldown_min, timeout_mult, item_rewards) overrides the db values; server only.
local function host_num(key, v)
	local ok, r = pcall(function() return coop_host_cfg.num("repeat_quests", key, v) end)
	if ok and r ~= nil then return r end
	return v
end

-- drops the cached settings (coop_host_cfg.reload, tests)
function host_reload()
	quests = nil
	reward_synced = false
end

local function load_cfg()
	if quests ~= nil then return end
	quests = {}
	ini = ini_file("misc\\coop_repeat_quests.ltx")
	local default_cd = 1440
	if ini:section_exist("defaults") and ini:line_exist("defaults", "cooldown_min") then
		default_cd = ini:r_float("defaults", "cooldown_min")
	end
	default_cd = host_num("cooldown_min", default_cd)
	local timeout_mult = host_num("timeout_mult", 1.0)
	if timeout_mult <= 0 then timeout_mult = 1.0 end
	local n = ini:line_count("list")
	for i = 0, n - 1 do
		local _, id, _ = ini:r_line("list", i, "", "")
		local q = {id = id, key = "RQ_" .. string.upper(id)}
		local function str(k, def)
			if ini:line_exist(id, k) then return ini:r_string(id, k) end
			return def
		end
		q.level = ini:r_string(id, "level")
		q.accept = ini:r_string(id, "accept")
		q.done = ini:r_string(id, "done")
		q.fail = ini:r_string(id, "fail")
		q.kind = str("kind", nil)
		q.smart = str("smart", nil)
		q.site = str("site", nil)
		q.item = str("item", nil)
		q.cd = default_cd
		if ini:line_exist(id, "cooldown_min") then q.cd = ini:r_float(id, "cooldown_min") end
		q.timeout = 2880
		if ini:line_exist(id, "timeout_min") then q.timeout = ini:r_float(id, "timeout_min") end
		q.timeout = q.timeout * timeout_mult
		q.spawn = {}
		local sp = str("spawn", "none")
		if sp ~= "none" then
			for squad, smart in string.gmatch(sp, "([%w_]+):([%w_]+)") do
				table.insert(q.spawn, {squad = squad, smart = smart})
			end
		end
		q.reward_items = {}
		for sec in string.gmatch(str("reward_items", ""), "[%w_.]+") do table.insert(q.reward_items, sec) end
		q.squads = {}
		for sec in string.gmatch(str("squads", ""), "[%w_]+") do table.insert(q.squads, sec) end
		table.insert(quests, q)
	end
end

-- quest clock in game minutes. The game clock does not advance on a dedicated server (tested: game_min stays the
-- same while real time passes), so use real time scaled by the time factor when os.time is available.
local function now_min()
	if os ~= nil and os.time ~= nil then
		local ok, tf = pcall(level.get_time_factor)
		if not ok or tf == nil or tf <= 0 then tf = 10 end
		return math.floor(os.time() * tf / 60)
	end
	if epoch == nil then
		epoch = game.CTime()
		epoch:set(2000, 1, 1, 0, 0, 0, 0)
	end
	return math.floor(game.get_game_time():diffSec(epoch) / 60)
end

local function has(f) return story_flags.has_flag(f) end
local function set_flag(f) story_flags.give_flag(f) end
local function clr_flag(f) story_flags.disable_flag(f) end

-- all numbers N for flags "<prefix>N" that are set
local function find_nums(prefix)
	local plen = string.len(prefix)
	local res = {}
	for k, v in pairs(story_flags.story_flags) do
		if v == true and string.sub(k, 1, plen) == prefix then
			local num = tonumber(string.sub(k, plen + 1))
			if num ~= nil then table.insert(res, num) end
		end
	end
	return res
end
local function find_num(prefix) return find_nums(prefix)[1] end

local function level_matches(q)
	local ln = level.name()
	return ln ~= nil and string.find(ln, q.level, 1, true) ~= nil
end

local function squad_alive(squad_id)
	local ok, s = pcall(get_story_squad, squad_id)
	return ok and s ~= nil
end

local function smart_obj(name)
	local board = sim_board.get_sim_board()
	if board == nil or board.smarts_by_names == nil then return nil end
	return board.smarts_by_names[name]
end

-- can the quest be (re)started on this level?
local function can_spawn(q)
	if q.kind == "gen_fetch" then return true end
	if q.kind ~= nil then
		if q.site ~= nil then return true end
		return q.smart ~= nil and smart_obj(q.smart) ~= nil
	end
	for _, sp in ipairs(q.spawn) do
		if smart_obj(sp.smart) == nil then return false end
	end
	return true
end

local function give_to_all(task_id)
	-- xr_effects.give_task falls through to getLocalActor() when db.mp_actors is empty: nil on a dedicated server
	if db.mp_actors == nil or next(db.mp_actors) == nil then return end
	xr_effects.give_task(nil, nil, {task_id})
end

-- map spots: the hint is the job's own string (name + short description, string id rq_spot_<job>). The spot is added on the server
-- (map_add_object_spot_ser) and pushed to every connected client (map_sync_spot, like the mod's treasure_manager); a client that
-- joins later gets it in catch_up(). Removal: map_remove_object_spot on the server drops it everywhere; it is called without
-- the has-spot guard (the guard is false for squads that were already released) and repeated while a duplicate is left.
local function add_spot(q, obj_id)
	if obj_id == nil then return end
	local typ = SPOT[q.kind] or "red_location"
	local ok, err = pcall(level.map_add_object_spot_ser, obj_id, typ, game.translate_string("rq_spot_" .. q.id))
	local ok2, err2 = pcall(level.map_sync_spot, obj_id, typ, SV_OBJECT_ID)
	printf_msg("[RQ] %s: spot on %s type %s add=%s sync=%s %s", q.id, tostring(obj_id), typ, tostring(ok), tostring(ok2), tostring(err2 or err))
	if ok then set_flag(q.key .. "_P" .. obj_id) end
end

local function remove_spot(q, id)
	local typ = SPOT[q.kind] or "red_location"
	for _ = 1, 3 do
		pcall(level.map_remove_object_spot, id, typ)
		local ok, has = pcall(level.map_has_object_spot, id, typ)
		if not ok or has == 0 then break end
	end
end

-- client side (called from sim_squad_scripted_cl_manager.dscript when a squad is removed): drop the local copy of a job spot that sat on it
function on_squad_removed(squad_id)
	pcall(level.map_remove_object_spot, squad_id, "red_location")
end

local function clear_tracking(q)
	for _, id in ipairs(find_nums(q.key .. "_P")) do
		remove_spot(q, id)
		clr_flag(q.key .. "_P" .. id)
	end
	for _, id in ipairs(find_nums(q.key .. "_S")) do clr_flag(q.key .. "_S" .. id) end
	for _, id in ipairs(find_nums(q.key .. "_I")) do clr_flag(q.key .. "_I" .. id) end
	for _, id in ipairs(find_nums(q.key .. "_T")) do clr_flag(q.key .. "_T" .. id) end
end

-- where a generated job puts its targets: the game graph vertex "site" (outside bases / safe zones / level exits), else the smart terrain
local function site_info(q)
	if q.site == nil then return nil end
	local nums = {}
	for w in string.gmatch(q.site, "[-%d%.]+") do table.insert(nums, tonumber(w)) end
	local ok, info = pcall(function()
		if #nums >= 5 then
			-- "x, y, z, level vertex id, game vertex id": a node of the level's AI map
			local v = game_graph():vertex(nums[5])
			if alife():level_name(v:level_id()) ~= level.name() then return nil end
			return {position = vector():set(nums[1], nums[2], nums[3]), m_level_vertex_id = nums[4], m_game_vertex_id = nums[5]}
		end
		-- a single number: a game graph vertex
		local v = game_graph():vertex(nums[1])
		if alife():level_name(v:level_id()) ~= level.name() then return nil end
		return {position = v:level_point(), m_level_vertex_id = v:level_vertex_id(), m_game_vertex_id = nums[1]}
	end)
	if ok then return info end
	printf_msg("[RQ] %s: site %s unusable: %s", q.id, tostring(q.site), tostring(info))
	return nil
end

-- like sim_board:create_squad, but the squad is created at a bare position and assigned to NO smart terrain: it stays where it was
-- created (a smart terrain would send the members to its jobs, i.e. into the base that lives there, and overflow its job slots)
-- The members would all stand on the one level vertex of the site (a crowd, all facing the same way). Put them on a loose ring of 4 to 7 m
-- around it, each facing outwards, on nodes of the AI map (pcall: on any problem a member keeps the site position).
local function spread_members(squad, site)
	local list = {}
	for k in squad:squad_members() do table.insert(list, k.id) end
	local n = #list
	if n < 2 then return end
	local a0 = math.random() * 6.2832
	for i, mid in ipairs(list) do
		pcall(function()
			local se = alife():object(mid)
			if se == nil then return end
			local a = a0 + (i - 1) * 6.2832 / n + (math.random() - 0.5) * 0.5
			local r = 4 + math.random() * 3
			local dir = vector():set(math.sin(a), 0, math.cos(a))
			local v = level.vertex_in_direction(site.m_level_vertex_id, dir, r)
			if v == nil or v == 4294967295 or v == site.m_level_vertex_id then return end
			local p = level.vertex_position(v)
			if p:distance_to(site.position) > r + 3 or math.abs(p.y - site.position.y) > 3 then return end
			se.position = p
			se.m_level_vertex_id = v
			se.angle = vector():set(0, a, 0)
			if db.spawned_vertex_by_id[mid] ~= nil then db.spawned_vertex_by_id[mid] = v end
		end)
	end
end

local function create_squad_at(board, site, sec, id)
	local squad = alife():create(sec, site.position, site.m_level_vertex_id, site.m_game_vertex_id)
	squad.rq_stay = true
	site.name = function() return id .. "_site" end
	squad:create_npc(site)
	spread_members(squad, site)
	squad:set_squad_relation()
	for k in squad:squad_members() do
		squad.board:setup_squad_and_group(k.object)
	end
	sim_squad_scripted_cl_manager.get_squad_manager():add_squad_sv(squad)
	return squad
end

-- Job squads stay at their site: sim_board:get_squad_target gives a squad without a smart terrain a simulation target when one exists (predatory mutant
-- squads hunt vegetarian squads on the level, bandits chase an actor within 10 m); for a squad flagged rq_stay it answers the squad itself, which is the
-- existing "nothing to do" result (the squad stays where it is). Installed once per level on the server, every call is guarded.
local stay_installed = false
local function install_stay()
	if stay_installed then return end
	stay_installed = true
	local ok, err = pcall(function()
		local cls = sim_board.sim_board
		local orig = cls.get_squad_target
		if orig == nil then return end
		cls.get_squad_target = function(self, squad)
			if squad ~= nil and squad.rq_stay == true then return squad end
			return orig(self, squad)
		end
	end)
	printf_msg("[RQ] stay-put hook installed=%s %s", tostring(ok), tostring(err))

	-- A squad without a smart terrain has no job, so its members got no logic section at all (initialize_obj reads an empty custom data and
	-- activates "nil"): no scheme, no state, they stand where they were put. Give the human members of a job squad the stock "remark"
	-- scheme with the SoC "guard" stance (misc\rq_job_logic.ltx); danger, combat and combat_ignore stay the stock generic schemes.
	local ok2, err2 = pcall(function()
		local orig = xr_logic.initialize_obj
		if orig == nil then return end
		xr_logic.initialize_obj = function(obj, st, loaded, actor, stype)
			if not loaded and stype == modules.stype_stalker then
				local mine = false
				pcall(function()
					local se = alife():object(obj:id())
					local sq = se ~= nil and se.group_id ~= nil and se.group_id ~= 65535 and alife():object(se.group_id) or nil
					mine = sq ~= nil and sq.rq_stay == true
				end)
				if mine then
					local fname = "misc\\rq_job_logic.ltx"
					local done = pcall(function()
						local ini = ini_file(fname)
						ini = xr_logic.configure_schemes(obj, ini, fname, stype, "logic", "")
						local sect = xr_logic.determine_section_to_activate(obj, ini, "logic", actor)
						xr_logic.activate_by_section(obj, ini, sect, st.gulag_name, false)
					end)
					if done then return end
				end
			end
			return orig(obj, st, loaded, actor, stype)
		end
	end)
	printf_msg("[RQ] job logic hook installed=%s %s", tostring(ok2), tostring(err2))
end

-- The "remark" scheme sets its state once and never looks about, so a guard would stand like a statue. SoC's camper and kamp schemes call
-- state_mgr.set_state(npc, state, nil, nil, {look_position = point}) to scan the area; do the same for the members of a job squad: every 6 to 14 s
-- a new point 14 m away within 100 degrees of the way the member faces. Only members that still run remark@rq_guard and have no enemy; every
-- call is guarded (any failure leaves the plain remark behaviour).
local look_due = {}
local look_base = {}
local function look_around(squad)
	local now = time_global()
	for k in squad:squad_members() do
		pcall(function()
			local id = k.id
			if look_due[id] ~= nil and now < look_due[id] then return end
			look_due[id] = now + 6000 + math.random() * 8000
			local obj = level.object_by_id(id)
			local st = db.storage[id]
			if obj == nil or st == nil or st.active_section ~= "remark@rq_guard" or not obj:alive() then return end
			if obj:best_enemy() ~= nil or obj:best_danger() ~= nil then return end
			if look_base[id] == nil then
				local d = obj:direction()
				look_base[id] = math.atan2(d.x, d.z)
			end
			local a = look_base[id] + (math.random() - 0.5) * 3.5
			local p = obj:position()
			state_mgr.set_state(obj, "guard", nil, nil, {look_position = vector():set(p.x + math.sin(a) * 14, p.y, p.z + math.cos(a) * 14)})
		end)
	end
end

-- spawn the targets of a generated job; returns true when something exists to hunt / find
local function spawn_generated(q)
	if q.kind == "gen_fetch" then
		-- nothing to spawn: the job only needs its start time (timeout) and the task
		set_flag(q.key .. "_T" .. now_min())
		return true
	end
	local site = site_info(q)
	local smart = smart_obj(q.smart)
	local where = site or smart
	if where == nil then return false end
	local spot_obj = nil
	if q.kind == "gen_find" then
		local ok, se = pcall(function()
			return alife():create(q.item, where.position, where.m_level_vertex_id, where.m_game_vertex_id)
		end)
		if not ok or se == nil then
			printf_msg("[RQ] %s: item spawn failed %s", q.id, tostring(se))
			return false
		end
		set_flag(q.key .. "_I" .. se.id)
		spot_obj = se.id
	else
		local board = sim_board.get_sim_board()
		for _, sec in ipairs(q.squads) do
			local ok, sq
			if site ~= nil then
				ok, sq = pcall(create_squad_at, board, site, sec, q.id)
			else
				ok, sq = pcall(board.create_squad, board, smart, sec)
			end
			if ok and sq ~= nil then
				printf_msg("[RQ] %s: squad %s (id %s) created %s", q.id, sec, tostring(sq.id), site ~= nil and ("at site " .. tostring(q.site)) or ("in smart " .. tostring(q.smart)))
				set_flag(q.key .. "_S" .. sq.id)
				spot_obj = spot_obj or sq.id
			else
				printf_msg("[RQ] %s: create_squad %s failed %s", q.id, sec, tostring(sq))
			end
		end
		if spot_obj == nil then return false end
	end
	add_spot(q, spot_obj)
	set_flag(q.key .. "_T" .. now_min())
	return true
end

local function start_cycle(q, cyc)
	if q.kind ~= nil then
		if not spawn_generated(q) then
			printf_msg("[RQ] %s: could not spawn targets, failing the job", q.id)
			set_flag(q.fail)
			set_flag(q.key .. "_A" .. cyc)
			return
		end
	else
		for _, sp in ipairs(q.spawn) do
			if not squad_alive(sp.squad) then
				local ok, err = pcall(xr_effects.create_squad, nil, nil, {sp.squad, sp.smart})
				printf_msg("[RQ] create_squad %s:%s ok=%s %s", sp.squad, sp.smart, tostring(ok), tostring(err))
			end
		end
	end
	give_to_all(q.id)
	set_flag(q.key .. "_A" .. cyc)
	printf_msg("[RQ] %s cycle %d task given", q.id, cyc)
end

local function squad_dead(sid)
	local so = alife():object(sid)
	if so == nil then return true end
	local ok, cnt = pcall(function() return so:npc_count() end)
	return ok and cnt == 0
end

-- running generated job: done when every spawned squad is dead, failed on timeout
local function monitor(q)
	if q.kind == "gen_find" or q.kind == "gen_fetch" then
		-- done flag is set by the hand-in dialog
	else
		local sids = find_nums(q.key .. "_S")
		if #sids > 0 then
			local all_dead = true
			for _, sid in ipairs(sids) do
				local so = alife():object(sid)
				if so ~= nil then
					so.rq_stay = true   -- also after a load (the flag is not saved)
					pcall(look_around, so)
				end
				if not squad_dead(sid) then all_dead = false break end
			end
			if all_dead then
				set_flag(q.done)
				clear_tracking(q)
				printf_msg("[RQ] %s: all targets dead -> done", q.id)
				return
			end
		end
	end
	local t0 = find_num(q.key .. "_T")
	if t0 ~= nil and now_min() - t0 >= q.timeout then
		set_flag(q.fail)
		clear_tracking(q)
		printf_msg("[RQ] %s: timed out -> failed", q.id)
	end
end

-- item rewards go straight into every connected player's inventory (the task manager can only pay money without an NPC)
local function grant_items(q)
	if db.mp_actors == nil then return end
	local okr, rewards = pcall(function() return coop_host_cfg.bool("repeat_quests", "item_rewards", true) end)
	if okr and rewards == false then return end
	for _, sec in ipairs(q.reward_items) do
		for id, a in pairs(db.mp_actors) do
			pcall(function()
				alife():create(sec, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id())
			end)
		end
	end
	if #q.reward_items > 0 then printf_msg("[RQ] %s: item reward granted (%d items each)", q.id, #q.reward_items) end
end

-- has the mod's one-shot quest restrictor already switched to its parked sr_idle@nil state?
function restrictor_fired(q)
	local ok, res = pcall(function()
		local ro = alife():object(q.id .. "_space_restrictor")
		if ro == nil then return false end
		local st = db.storage[ro.id]
		return st ~= nil and st.active_section == "sr_idle@nil"
	end)
	return ok and res == true
end

local function update_quest(q)
	local cyc = find_num(q.key .. "_C") or 0
	local accepted, done, failed = has(q.accept), has(q.done), has(q.fail)
	local act = has(q.key .. "_A" .. cyc)
	local ready = find_num(q.key .. "_R")
	local active = accepted and not done and not failed
	if active and q.kind ~= nil and not level_matches(q) then return end   -- targets only exist on their own level

	if active and not act then
		if cyc == 0 and q.kind == nil then
			-- legacy first run: the mod's restrictor gives the task, but only while it is online (near a player).
			-- If it did not fire within the grace period, do it ourselves.
			if restrictor_fired(q) then
				set_flag(q.key .. "_A0")
				printf_msg("[RQ] %s: mod restrictor handled the first run", q.id)
			else
				local now = time_global()
				q.seen_accept = q.seen_accept or now
				if now - q.seen_accept < GRACE_MS then return end
				printf_msg("[RQ] %s: restrictor offline, script takes over the first run", q.id)
				q.seen_accept = nil
				start_cycle(q, 0)
			end
		else
			start_cycle(q, cyc)
		end
		return
	end
	if active and q.kind ~= nil then
		monitor(q)
		return
	end

	if (done or failed) and ready == nil then
		local cd = cooldown_override_min or q.cd
		set_flag(q.key .. "_R" .. (now_min() + cd))
		if q.kind ~= nil then clear_tracking(q) end
		if done and not failed then grant_items(q) end
		printf_msg("[RQ] %s finished (done=%s fail=%s), refresh in %d game min", q.id, tostring(done), tostring(failed), cd)
		return
	end

	if ready ~= nil and now_min() >= ready and not q.block_logged and not (level_matches(q) and can_spawn(q)) then
		q.block_logged = true
		printf_msg("[RQ] %s due but blocked: level_ok=%s spawn_ok=%s level=%s", q.id, tostring(level_matches(q)), tostring(can_spawn(q)), tostring(level.name()))
	end
	if ready ~= nil and now_min() >= ready and level_matches(q) and can_spawn(q) then
		q.block_logged = nil
		clr_flag(q.accept); clr_flag(q.done); clr_flag(q.fail)
		clr_flag(q.key .. "_A" .. cyc)
		clr_flag(q.key .. "_R" .. ready)
		if cyc > 0 then clr_flag(q.key .. "_C" .. cyc) end
		set_flag(q.key .. "_C" .. (cyc + 1))
		printf_msg("[RQ] %s refreshed -> cycle %d, offered again", q.id, cyc + 1)
	end
end

-- late join: give every running repeatable task to actors that appeared after we last looked
local function catch_up()
	if db.mp_actors == nil then return end
	local cur = {}
	for id, v in pairs(db.mp_actors) do cur[id] = true end
	if known_actors == nil then known_actors = cur return end
	local fresh = {}
	for id in pairs(cur) do
		if not known_actors[id] then table.insert(fresh, id) end
	end
	known_actors = cur
	if #fresh == 0 then return end
	if not IsAllClientsConnectedToActors() then
		known_actors = nil -- retry once everyone is connected
		return
	end
	for _, q in ipairs(quests) do
		local cyc = find_num(q.key .. "_C") or 0
		if has(q.accept) and not has(q.done) and not has(q.fail) and has(q.key .. "_A" .. cyc) then
			for _, id in ipairs(fresh) do
				client_tasks.give_task_to_client(q.id, id)
				printf_msg("[RQ] late join: task %s -> actor %s", q.id, tostring(id))
				for _, pid in ipairs(find_nums(q.key .. "_P")) do
					pcall(level.map_sync_spot, pid, SPOT[q.kind] or "red_location", id)
				end
			end
		end
	end
end

-- the host setting item_rewards is read on the server only; clients (hand-in dialog of the fetch jobs) see it as this story flag
local function sync_reward_flag()
	local ok, r = pcall(function() return coop_host_cfg.bool("repeat_quests", "item_rewards", true) end)
	local off = ok and r == false
	if off then
		if not has("RQ_NO_ITEM_REWARDS") then set_flag("RQ_NO_ITEM_REWARDS") end
	elseif has("RQ_NO_ITEM_REWARDS") then
		clr_flag("RQ_NO_ITEM_REWARDS")
	end
end

function update()
	if not OnServer() then return end
	local t = time_global()
	if t - last_tick < TICK_MS then return end
	last_tick = t
	if db.mp_actors == nil or next(db.mp_actors) == nil then return end
	load_cfg()
	install_stay()
	if not reward_synced then
		reward_synced = true
		pcall(sync_reward_flag)
	end
	if t - (last_clock or 0) > 30000 then
		last_clock = t
		local ok, tf = pcall(level.get_time_factor)
		printf_msg("[RQ] clock game_min=%s time_factor=%s os_time=%s", tostring(now_min()), tostring(ok and tf), tostring(os and os.time and os.time()))
	end
	for _, q in ipairs(quests) do
		local ok, err = pcall(update_quest, q)
		if not ok then printf_msg("[RQ] error %s: %s", q.id, tostring(err)) end
	end
	local ok, err = pcall(catch_up)
	if not ok then printf_msg("[RQ] catch_up error: %s", tostring(err)) end
end
