-- Generated: hand-in helpers for the find-item jobs (same pattern as dialogs_item.script).

function has_rq_detector_simple(first_speaker, second_speaker)
	local actor = db.mp_actors[LocalActor()]
	if actor == nil then return false end
	return actor:object("detector_simple") ~= nil
end

function take_rq_detector_simple(first_speaker, second_speaker)
	dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "detector_simple", 1)
end

