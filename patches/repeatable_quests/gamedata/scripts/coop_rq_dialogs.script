-- fetch jobs (bring an artifact / a mutant part): the whole SoC set, generated by tools/gen_fetch.py (see NOTES.md). The talking player hands in and is paid.
-- giver / kind / prior / gate = who offers it, art or part, SoC priority, story flags required. secs = accepted sections (an artifact exists as af_x and as its
-- SoC twin af_x_soc), count = pieces, money / items = pay to that player.
local FETCH = {
	rq_sid_art1 = {giver = "sid", kind = "art", prior = 1, gate = {}, secs = {"af_medusa", "af_medusa_soc"}, count = 1, money = 1500, items = {"vodka"}},
	rq_sid_art2 = {giver = "sid", kind = "art", prior = 2, gate = {}, secs = {"af_cristall_flower", "af_cristall_flower_soc"}, count = 1, money = 3000, items = {"vodka"}},
	rq_sid_art4 = {giver = "sid", kind = "art", prior = 3, gate = {}, secs = {"af_mincer_meat", "af_mincer_meat_soc"}, count = 1, money = 2500, items = {"medkit_army", "medkit_army", "medkit_army"}},
	rq_sid_part1 = {giver = "sid", kind = "part", prior = 2, gate = {"AGR_START_BREAK_INTO_A_MILITARY_BASE_QUEST_TASK_INFO"}, secs = {"mutant_krovosos_part"}, count = 1, money = 3000, items = {"ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart"}},
	rq_sid_part2 = {giver = "sid", kind = "part", prior = 1, gate = {}, secs = {"mutant_psevdodog_part"}, count = 1, money = 1500, items = {"ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart"}},
	rq_bar_art1 = {giver = "bar", kind = "art", prior = 1, gate = {}, secs = {"af_mincer_meat", "af_mincer_meat_soc"}, count = 1, money = 2500, items = {"medkit_scientic", "medkit_scientic"}},
	rq_bar_art2 = {giver = "bar", kind = "art", prior = 3, gate = {"BAR_SMART_TERRAIN_1_STALKER_BARMEN_1_HAS_DOCUMENTS_DARKVALLEY_STOP_DIALOG_INFO"}, secs = {"af_rusty_kristall_soc"}, count = 1, money = 2500, items = {"medkit_scientic", "medkit_scientic", "antirad", "antirad"}},
	rq_bar_art3 = {giver = "bar", kind = "art", prior = 4, gate = {}, secs = {"af_night_star", "af_night_star_soc"}, count = 1, money = 0, items = {"specops_outfit", "grenade_f1", "grenade_f1", "grenade_f1"}},
	rq_bar_art4 = {giver = "bar", kind = "art", prior = 2, gate = {"BAR_SMART_TERRAIN_1_STALKER_BARMEN_1_HAS_DOCUMENTS_DARKVALLEY_STOP_DIALOG_INFO"}, secs = {"af_electra_flash", "af_electra_flash_soc"}, count = 1, money = 5000, items = {}},
	rq_bar_art5 = {giver = "bar", kind = "art", prior = 5, gate = {"X16_START_GET_OUT_OF_THE_LAB_TASK_INFO"}, secs = {"af_gold_fish", "af_gold_fish_soc"}, count = 1, money = 0, items = {"wpn_lr300", "wpn_addon_grenade_launcher_m203", "wpn_addon_scope_susat", "wpn_addon_silencer"}},
	rq_bar_part1 = {giver = "bar", kind = "part", prior = 1, gate = {}, secs = {"mutant_flesh_part"}, count = 1, money = 500, items = {"conserva", "conserva", "conserva"}},
	rq_bar_part2 = {giver = "bar", kind = "part", prior = 2, gate = {}, secs = {"mutant_boar_part"}, count = 1, money = 1500, items = {}},
	rq_sak_art1 = {giver = "sak", kind = "art", prior = 3, gate = {}, secs = {"af_fireball", "af_fireball_soc"}, count = 1, money = 0, items = {"af_dummy_pellicle_soc"}},
	rq_sak_art2 = {giver = "sak", kind = "art", prior = 1, gate = {}, secs = {"af_gravi", "af_gravi_soc"}, count = 1, money = 5000, items = {"medkit_scientic"}},
	rq_sak_art3 = {giver = "sak", kind = "art", prior = 2, gate = {}, secs = {"af_medusa", "af_medusa_soc"}, count = 1, money = 2500, items = {"medkit_scientic"}},
	rq_sak_art4 = {giver = "sak", kind = "art", prior = 4, gate = {}, secs = {"af_electra_moonlight", "af_electra_moonlight_soc"}, count = 1, money = 10000, items = {"medkit_scientic", "medkit_scientic", "medkit_scientic"}},
	rq_sak_art5 = {giver = "sak", kind = "art", prior = 5, gate = {}, secs = {"af_rusty_sea-urchin_soc"}, count = 1, money = 0, items = {"scientific_outfit"}},
	rq_sak_part1 = {giver = "sak", kind = "part", prior = 1, gate = {}, secs = {"mutant_snork_part"}, count = 1, money = 2500, items = {"medkit_scientic"}},
	rq_sak_part2 = {giver = "sak", kind = "part", prior = 2, gate = {}, secs = {"mutant_flesh_part"}, count = 1, money = 1000, items = {"wpn_addon_scope_susat"}},
	rq_sak_part3 = {giver = "sak", kind = "part", prior = 3, gate = {}, secs = {"mutant_boar_part"}, count = 1, money = 2000, items = {"ammo_12x76_dart", "ammo_12x76_dart", "ammo_12x76_dart"}},
	rq_sak_part4 = {giver = "sak", kind = "part", prior = 4, gate = {}, secs = {"mutant_psevdodog_part"}, count = 1, money = 3000, items = {"medkit_scientic"}},
	rq_sak_part5 = {giver = "sak", kind = "part", prior = 5, gate = {}, secs = {"mutant_krovosos_part"}, count = 1, money = 6000, items = {"medkit_scientic"}},
	rq_fre_part1 = {giver = "fre", kind = "part", prior = 1, gate = {}, secs = {"mutant_boar_part"}, count = 1, money = 1000, items = {"vodka"}},
}

local function rq_flag(id, suffix) return "RQG_" .. string.upper(id) .. "_" .. suffix end

-- the player who talks (the one who hands in); the NPC is the other speaker
local function rq_actor(first_speaker, second_speaker)
	local ok, npc, actor = pcall(dialogs.who_is_npc, first_speaker, second_speaker)
	if ok and actor ~= nil then return actor end
	if db.mp_actors == nil then return nil end
	return db.mp_actors[LocalActor()]
end

local function rq_count(actor, secs)
	local n = 0
	actor:iterate_inventory(function(dummy, item)
		local s = item:section()
		for _, sec in ipairs(secs) do if s == sec then n = n + 1 end end
	end, nil)
	return n
end

local function fetch_has(id, first_speaker, second_speaker)
	local f = FETCH[id]
	local actor = rq_actor(first_speaker, second_speaker)
	if f == nil or actor == nil then return false end
	return rq_count(actor, f.secs) >= f.count
end

-- takes the pieces from the talking player (twins one after the other); false when it could not take all of them
local function fetch_take(id, first_speaker, second_speaker)
	local f = FETCH[id]
	local actor = rq_actor(first_speaker, second_speaker)
	if f == nil or actor == nil then return false end
	local need = f.count
	for _, sec in ipairs(f.secs) do
		local n = math.min(rq_count(actor, {sec}), need)
		for _ = 1, n do dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, sec) end
		need = need - n
	end
	return need == 0
end

-- hand-in: item(s) away, money and items to the player who talks. The flag RQ_NO_ITEM_REWARDS (host setting item_rewards = false) drops the items.
local function fetch_pay(id, first_speaker, second_speaker)
	local f = FETCH[id]
	if f == nil or not fetch_take(id, first_speaker, second_speaker) then return end
	if f.money > 0 then pcall(dialogs.relocate_money_to_actor, first_speaker, second_speaker, f.money) end
	if story_flags.has_flag("RQ_NO_ITEM_REWARDS") then return end
	for _, sec in ipairs(f.items) do pcall(dialogs.relocate_item_section_to_actor, first_speaker, second_speaker, sec, 1) end
end

-- the hand-in dialog of a giver only shows while the talking player has a running fetch job of this giver (accepted, not done, not failed)
-- AND carries what it asks for
local function fetch_open(giver, first_speaker, second_speaker)
	for id, f in pairs(FETCH) do
		if f.giver == giver and story_flags.has_flag(rq_flag(id, "ACC")) and not story_flags.has_flag(rq_flag(id, "DONE")) and not story_flags.has_flag(rq_flag(id, "FAIL"))
			and fetch_has(id, first_speaker, second_speaker) then return true end
	end
	return false
end

-- BEGIN fetch_offer (generated by tools/gen_fetch.py)
-- SoC task_manager rules: a giver offers per kind (art / part) only the available order with the lowest priority (prior); while an order of the kind runs
-- no other of that kind is offered; an order whose story condition (gate flags = SoC condlist) is not met, or that waits for its cooldown (accept flag
-- set, done / fail set: the repeat script clears them when it is due), is not available.
local function fetch_gate_ok(f)
	for _, g in ipairs(f.gate) do
		if not story_flags.has_flag(g) then return false end
	end
	return true
end

-- "free" = can be offered (not accepted), "active" = accepted and running, "wait" = finished, waiting for the cooldown
local function fetch_state(id)
	if not story_flags.has_flag(rq_flag(id, "ACC")) then return "free" end
	if story_flags.has_flag(rq_flag(id, "DONE")) or story_flags.has_flag(rq_flag(id, "FAIL")) then return "wait" end
	return "active"
end

function fetch_offer(id)
	local f = FETCH[id]
	if f == nil or not fetch_gate_ok(f) or fetch_state(id) ~= "free" then return false end
	for id2, f2 in pairs(FETCH) do
		if id2 ~= id and f2.giver == f.giver and f2.kind == f.kind then
			local st = fetch_state(id2)
			if st == "active" then return false end
			if st == "free" and f2.prior < f.prior and fetch_gate_ok(f2) then return false end
		end
	end
	return true
end
-- END fetch_offer

-- old "find" jobs (the item lies at a map spot): giver -> job id and item. Same rule for the hand-in dialog.
local FIND = {
	wolf = {id = "rq_shu_find", sec = "wpn_fort"},
	vor = {id = "rq_vor_find", sec = "wpn_ak74u"},
	inf = {id = "rq_inf_find", sec = "wpn_desert_eagle"},
	zho = {id = "rq_zho_find", sec = "vodka"},
	sak = {id = "rq_sak_find", sec = "detector_simple"},
}

local function find_open(giver, first_speaker, second_speaker)
	local f = FIND[giver]
	if f == nil then return false end
	if not story_flags.has_flag(rq_flag(f.id, "ACC")) or story_flags.has_flag(rq_flag(f.id, "DONE")) or story_flags.has_flag(rq_flag(f.id, "FAIL")) then return false end
	local actor = rq_actor(first_speaker, second_speaker)
	return actor ~= nil and actor:object(f.sec) ~= nil
end

function fetch_open_sid(first_speaker, second_speaker) return fetch_open("sid", first_speaker, second_speaker) end
function fetch_open_bar(first_speaker, second_speaker) return fetch_open("bar", first_speaker, second_speaker) end
function fetch_open_sak(first_speaker, second_speaker) return fetch_open("sak", first_speaker, second_speaker) end
function fetch_open_fre(first_speaker, second_speaker) return fetch_open("fre", first_speaker, second_speaker) end

