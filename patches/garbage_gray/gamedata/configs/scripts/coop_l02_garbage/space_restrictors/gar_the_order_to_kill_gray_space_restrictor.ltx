[logic]
active 												= sr_idle@start_quest

; Second way to start the bandit attack on Gray's group (the first one is the server tick of garbage_duty, which follows the SoC zones
; gar_seryi_factory / gar_seryi_igrok_durak_restrictor / gar_bandits_shuher). SoC rule of gar_seryi_factory: a player inside, 30 s later the
; attack (on_actor_inside -> sr_idle@time, on_timer = 30000 | nil %+gar_begin_assault%). Here: any player on the hill, 30 s later.
[sr_idle@start_quest]
on_any_player_inside 									= sr_idle@time
on_info 											= {+AGRU_START_RETURN_TO_THE_SURFACE_TASK_END_INFO} sr_idle@nil

[sr_idle@time]
on_timer 											= 30000 | sr_idle@nil %+GAR_THE_ORDER_TO_KILL_GRAY_INFO%
on_info 											= {+AGRU_START_RETURN_TO_THE_SURFACE_TASK_END_INFO} sr_idle@nil

[sr_idle@nil]
