prior 									= 200
storyline 								= true
title 									= st_sar_soc_wish_name
descr 									= st_sar_soc_sneak_in_descr
target 									= nil
condlist_0 								= {+SAR_MONOLITH_FIND} complete
condlist_1 								= {+SAR_MONOLITH_WISH_SPACE_RESTRICTOR_INFO} complete
condlist_2 								= {+SAR_ENTER_COMMAND_CENTER} complete


