; CNPP-1 helicopter 5 (patch soc_aes_war, v1.4.3). Old v1.4.2 file: it flew its route and never fired; now it patrols the loop and the script
; coop_soc_aes_war gives it enemies (Monolith soldiers, players inside the SoC helicopter zones). Machine gun only.
; The section names of the old file are kept (a save stores the active section by name).
[logic]
active = heli_move@idle

; waits in the yard behind the start until the party is here ({+SOC_AESW_GO} is given by the script) or the mod's own quest flag is set
[heli_move@idle]
path_move = aes_1_helicopter_5_idle_way
max_velocity = 300
engine_sound = false
use_rocket = false
on_info = {+PRI_START_GO_TO_CNPP_QUEST_TASK_INFO} heli_move@fly_ready, {+SOC_AESW_GO} heli_move@fly_ready

[heli_move@fly_ready]
path_move = aes_1_helicopter_5_idle_way
max_velocity = 150
engine_sound = true
use_rocket = false
on_timer = 20000 | heli_move@fly_0

[heli_move@fly_0]
path_move = aes_1_helicopter_5_move_way_0
max_velocity = 150
engine_sound = true
use_rocket = false
on_timer = 7000 | heli_move@fly_1

[heli_move@fly_1]
path_move = aes_1_helicopter_5_move_way_0
max_velocity = 90
engine_sound = true
use_rocket = false
use_mgun = true
