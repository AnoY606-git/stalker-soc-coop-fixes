-- Sarcophagus FPS fix: ordinary Monolith squads in the Sarcophagus keep only
-- sarcophagus_wave_percent (sarcophagus_fps.txt) of their members, at least 1.
function sar_fps_trim_squad(squad, squad_id)
	if level.name() ~= "coop_l11_sarcofag" or not string.find(squad_id, "ordinary_monolith", 1, true) then
		return
	end
	local ids = {}
	for k in squad:squad_members() do
		table.insert(ids, k.id)
	end
	local pct = sar_fps_cfg.get("sarcophagus_wave_percent")
	local keep = math.max(1, math.ceil(#ids * pct / 100))
	local extra = {}
	for i = #ids, keep + 1, -1 do
		table.insert(extra, ids[i])
	end
	if #extra == 0 or level.add_call == nil then
		return
	end
	-- Remove the extra members a second later: releasing an object in the frame it was
	-- created breaks the smart terrain's unregister log line (the name is not set yet).
	local due = time_global() + 1000
	level.add_call(function() return time_global() >= due end, function()
		local mgr = sim_squad_scripted_cl_manager.get_squad_manager()
		for _, id in ipairs(extra) do
			local se_obj = alife():object(id)
			if se_obj ~= nil and se_obj:alive() then
				squad.sound_manager:unregister_npc(id)
				squad:unregister_member(id)
				mgr:remove_member(squad.id, id)
				alife():release(se_obj, true)
			end
		end
		printf("[SAR_FPS] %s: kept %s of %s", tostring(squad_id), tostring(#ids - #extra), tostring(#ids))
	end)
end

-- Same as the xrMPE create_squad, plus sar_fps_trim_squad.
function create_squad(actor, obj, p)
	if OnClient() then
		return
	end
	local squad_id = p[1]
	if squad_id == nil then
		abort("Wrong squad identificator [NIL] in create_squad function")
	end
	local smart_name = p[2]
	if smart_name == nil then
		abort("Wrong smart name [NIL] in create_squad function")
	end
	local ltx = sim_board.squad_ltx
	if not ltx:section_exist(squad_id) then
		abort("Wrong squad identificator [%s]. Squad descr doesnt exist.", tostring(squad_id))
	end
	local board = sim_board.get_sim_board()
	local smart = board.smarts_by_names[smart_name]
	if smart == nil then
		abort("Wrong smart_name [%s] in create_squad function", tostring(smart_name))
	end

	local squad = board:create_squad(smart, squad_id)
	sar_fps_trim_squad(squad, squad_id)

	board:enter_smart(squad, smart.id)
	for k in squad:squad_members() do
		board:setup_squad_and_group(k.object)
	end
	squad:update()
end

-- CNPP shake fix: stc_surge/stc_stop_surge use this id for the looping surge_shock.ppe, but it was never defined.
surge_shock_pp_eff = 20080402
