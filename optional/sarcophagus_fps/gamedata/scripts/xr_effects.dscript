function show_test_dialog(actor, npc, p)
	if p[1] and p[2] and p[2] == "true" then
		ui_test_dialog.show("message_box_yes_no", p[1])
	end
end

-------------------------------------------------------------------------------------------------------
-- Party map vote (guide transitions)
-------------------------------------------------------------------------------------------------------
function coop_map_vote_begin(actor, npc, p)
	if p and p[1] and OnServer() then
		coop_map_vote.start(p[1])
	end
end

function coop_map_vote_prompt(actor, npc, p)
	local text_id = "st_coop_map_vote_default"
	if p and p[1] then
		text_id = p[1]
	end
	coop_map_vote.prompt_client(text_id)
end

function coop_map_vote_reset_prompt(actor, npc, p)
	coop_map_vote.reset_client_prompt()
end

